---- MODULE ReviewerData ----
\* Generated by gen-data.js from review-matrix.js, matrix version 3. Do not edit.
EXTENDS Naturals

\* The grid: the risk grade by exposure level and worst severity.
Grade(l, s) ==
  CASE l = "low" /\ s = "S0" -> "approve"
    [] l = "low" /\ s = "S1" -> "approve"
    [] l = "low" /\ s = "S2" -> "approve"
    [] l = "low" /\ s = "S3" -> "needs_taap"
    [] l = "medium" /\ s = "S0" -> "approve"
    [] l = "medium" /\ s = "S1" -> "approve"
    [] l = "medium" /\ s = "S2" -> "needs_taap"
    [] l = "medium" /\ s = "S3" -> "needs_taap"
    [] l = "high" /\ s = "S0" -> "approve"
    [] l = "high" /\ s = "S1" -> "approve"
    [] l = "high" /\ s = "S2" -> "needs_taap"
    [] l = "high" /\ s = "S3" -> "needs_taap"

\* The Veracity floor by exposure level.
Floor(l) ==
  CASE l = "low" -> 0
    [] l = "medium" -> 3
    [] l = "high" -> 3

\* The rank of each evidence level.
EvRank(e) ==
  CASE e = "E0" -> 0
    [] e = "E1-" -> 1
    [] e = "E1" -> 2
    [] e = "E1+" -> 3
    [] e = "E2a" -> 4
    [] e = "E2b" -> 4
    [] e = "E3a" -> 4
    [] e = "E3b" -> 5

\* The TAAP standard: requirements a plan must meet at each pressure.
Required(p) ==
  CASE p = 0 -> 3
    [] p = 1 -> 3
    [] p = 2 -> 4
    [] p = 3 -> 6
    [] p = 4 -> 6

TaapCount == 6
