// =====================================================================================
// Principles pass: groundings and new principles from the impact matrix research.
// Prepared 2026-10-16 for Daniel Fontaine. Follows curate_2026_10_16_governance_impact_matrix_grounding.
// GENERATED by a scratch builder that verified every quote, whitespace-normalized, against
// the stored raw_text of the node it cites. Re-run the builder rather than editing quotes.
//
// USER DECISIONS (2026-10-16)
//   - Cases carry an authority: binding (applies directly to the CSU) or persuasive
//     (usable as interpretation). Groundings on binding cases use the new grounding_kind
//     binding_precedent; groundings on persuasive cases and agreements use interpretation.
//   - Cox, Thomas et al. and Krisper contest prioritization-by-impact, scoped to the method.
//   - Five new principles. Two proposals folded into existing principles instead:
//     denial-carries-reasons-and-a-path into deference-earned-through-documented-process,
//     determinations-expire into time-bound-alternative-when-not-conformant.
//
// SECTIONS
//   1. Descriptors for Case.authority and its two values.
//   2. Case.authority on all 21 Case nodes. Binding: Payan (2021, 2026), Robles and Enyart
//      (Ninth Circuit), Brennon B. (California Supreme Court), and the OCR findings against
//      CSU Long Beach and CSU Los Angeles. All others persuasive.
//   3. The five new Principle nodes.
//   4. Two folds, appended to description_full once (guarded by a marker sentence).
//   5. derives_from groundings (43 edges). MERGE with ON CREATE SET, so no existing
//      grounding is overwritten. Checked beforehand: none of these pairs existed.
//   6. contested_by edges on prioritization-by-impact (3).
//
// NOT DONE
//   - shapes edges for the new principles. Separate pass.
//   - The South Carolina and Penn State cases have no stored text and ground nothing here.
//   - Thomas et al.: stored text is letter-spaced from the PDF and should be re-captured.
//
// VALIDATE FIRST
//   python -m app.database.cypher_runner.run_file app/database/batch/auto-assignments/curate_2026_10_16_principles_impact_matrix.cypher
//   python -m app.database.cypher_runner.run_file app/database/batch/auto-assignments/curate_2026_10_16_principles_impact_matrix.cypher --execute
// =====================================================================================

// --- 1. Descriptors ------------------------------------------------------------------
MERGE (d:UniversalDescriptor {descriptor_handle: "field:Case.authority"})
ON CREATE SET d.unique_id = replace(randomUUID(), "-", ""), d.descriptor_kind = "field",
              d.target_label = "Case", d.target_field = "authority", d.title = "Case.authority",
              d.description_short = "Whether a case applies directly to the CSU (binding) or can only be used as interpretation (persuasive).",
              d.description_full = "Binding means the ruling or finding governs the CSU: precedent of the Ninth Circuit or the California Supreme Court, or an OCR finding against a CSU campus. Persuasive means it binds another institution or another jurisdiction, so it shows how a regulator or court reads the law without governing the CSU. Principle groundings on binding cases use grounding_kind binding_precedent; groundings on persuasive cases use interpretation.",
              d.search_text = "case.authority binding persuasive applies directly to the csu interpretation precedent ninth circuit resolution agreement",
              d.include_in_report = false, d.last_updated = date("2026-10-16");

UNWIND [
  {v: "binding", s: "The case applies directly to the CSU: Ninth Circuit or California Supreme Court precedent, or an OCR finding against a CSU campus."},
  {v: "persuasive", s: "The case binds another institution or jurisdiction. It can be used as interpretation of the law, not as a rule that governs the CSU."}
] AS row
MERGE (d:UniversalDescriptor {descriptor_handle: "field_value:authority." + row.v})
ON CREATE SET d.unique_id = replace(randomUUID(), "-", ""), d.descriptor_kind = "field_value",
              d.target_label = "Case", d.target_field = "authority", d.target_value = row.v,
              d.title = row.v, d.description_short = row.s, d.description_full = row.s,
              d.search_text = "case authority " + row.v + " " + toLower(row.s),
              d.include_in_report = false, d.last_updated = date("2026-10-16");

// --- 2. Case.authority -------------------------------------------------------------------
MATCH (c:Case)
SET c.authority = CASE WHEN c.unique_id IN ["0b2b339725a346c9866d81a2711b7ef6", "11c08bb121d841a0bfd6aac0124a8492", "36cc1ca0c2414eb3a5abfa2c7ad4e3ef", "4c56a67dbc3c499d9c3646a75f4c1943", "9e6742ad98344681afcada5d1bcf5bf8", "c45c23634e07430aa3f74234686578a8", "d82997ae08354fe1b30385221415d4b4"] THEN "binding" ELSE "persuasive" END;

// --- 3. New principles -------------------------------------------------------------------
MERGE (p:Principle {handle: "principle:exposure-sets-scrutiny-not-entitlement"})
ON CREATE SET p.unique_id = replace(randomUUID(), "-", "")
SET p.name = "Exposure sets scrutiny, not entitlement",
    p.description_short = "How widely a technology is used decides how closely it is reviewed and who signs. It does not decide whether people with disabilities are owed access.",
    p.description_full = "Title II and Section 504 set no threshold of users, criticality or exposure below which a public entity may deny access. The Title II regulation forbids denying a qualified person the opportunity to participate in or benefit from an aid, benefit or service, and it states no exception for small or optional uses. Enforcement has read it the same way. The complaints behind the 2010 Dear Colleague Letter concerned pilots of e-readers, and OCR's 2011 answers say the obligations apply to pilot programs and apply when no student with a visual impairment is enrolled.\n\nExposure still matters, because review capacity is finite. Federal testing guidance sets the minimum test scope at public-facing, frequently used or critical functions. An exposure rating can therefore decide how deep a review goes, how strong the evidence must be, and who approves an exception.\n\nIt cannot make an inaccessible product acceptable. A low rating that ends in approval of a product with a blocking barrier is a denial of access recorded as a review outcome. This principle governs the first stage of the impact matrix: that stage sets scrutiny, and barrier severity and evidence decide the outcome.";

MERGE (p:Principle {handle: "principle:vendor-claims-require-proportionate-validation"})
ON CREATE SET p.unique_id = replace(randomUUID(), "-", "")
SET p.name = "Vendor claims require proportionate validation",
    p.description_short = "A vendor's accessibility conformance report is a claim. The evidence required to accept it rises with the product's exposure.",
    p.description_full = "An Accessibility Conformance Report is written by the party selling the product. Federal guidance tells buyers to verify vendor conformance claims through independent testing whenever possible. The CSU procurement process lists a vendor demonstration to validate ACR conformance claims among its usual contract requirements. GSA asks vendors for an issue-level supplement that states each defect's severity, the affected user group and any workaround.\n\nExpert judgment varies too. In a study of WCAG 2.0 evaluation, about half of the success criteria fell short of 80 percent agreement among knowledgeable evaluators. A repeatable manual test method, such as the DHS Trusted Tester process, narrows that variation.\n\nValidation is proportionate. A low-exposure purchase can rest on an ACR that passes quality checks. A high-exposure purchase needs a demonstration of essential functions, a third-party audit, or ATI testing before approval. This principle grounds the evidence ladder in the impact matrix and indicator 1.8-pro's process for validating conformance claims.";

MERGE (p:Principle {handle: "principle:most-accessible-product-that-meets-the-need"})
ON CREATE SET p.unique_id = replace(randomUUID(), "-", "")
SET p.name = "Buy the most accessible product that meets the need",
    p.description_short = "The university selects the most accessible product that meets its business requirements, and buys a non-conforming product only when no conforming one is available.",
    p.description_full = "The Revised 508 Standards, which Government Code 7405 applies to state procurement, require an agency to procure the product that best meets the standards when no product fully conforms. That choice must be documented with the market research performed and the provisions that cannot be met, and it must come with an alternative means of access. The CSU procurement process gives the purchase requester the same duty: conduct market research and select the most accessible product or service that meets requirements.\n\nEnforcement applies the same test. The Louisiana Tech settlement required the university to procure the product that best meets the standard when none fully conforms. The Miami consent decree let the university weigh a vendor's contractual commitment to conform when deciding which product best meets the standard.\n\nTwo consequences follow for review. A denial is most defensible when a more accessible product meets the need. When nothing on the market conforms, the path is a best-meets record with alternative access, not a denial and not an unqualified approval. This principle grounds the market-research input to the outcome stage of the impact matrix.";

MERGE (p:Principle {handle: "principle:duty-runs-through-contracts"})
ON CREATE SET p.unique_id = replace(randomUUID(), "-", "")
SET p.name = "The duty runs through contracts",
    p.description_short = "Technology a vendor provides under a contract or license is the university's own for accessibility purposes.",
    p.description_full = "The Title II regulation forbids discrimination by a public entity directly or through contractual, licensing, or other arrangements. The 2024 web rule applies the same words to the web content and mobile apps a public entity provides or makes available. The Section 504 regulation uses them for recipients of federal funds. DOJ's guidance on the web rule tells public entities to make sure content or mobile apps a vendor provides or posts on their behalf conform to WCAG 2.1 Level AA.\n\nOCR has applied this to purchasing. The Youngstown State agreement required a procedure so that any acquisition or use of third-party websites, services or products provides equal opportunity.\n\nA vendor-hosted platform therefore carries the university's duty. A barrier in it is the university's barrier, whatever the contract says about who maintains the code. This principle differs from the principle that procurement is a lever. That principle concerns using buying power to improve products. This one concerns who answers for the barriers in a product already bought.";

MERGE (p:Principle {handle: "principle:same-facts-same-answer"})
ON CREATE SET p.unique_id = replace(randomUUID(), "-", "")
SET p.name = "Same facts, same answer",
    p.description_short = "Two reviewers given the same facts reach the same result, and the rubric is tested to show that they do.",
    p.description_full = "A review rubric is defensible only if it is reliable. If two reviewers rate the same purchase differently, the outcome depends on who reviewed it rather than on the product. Agreement can be measured. Content analysis sets a convention of relying on Krippendorff's alpha of 0.800 or higher, and Landis and Koch's bands treat kappa between 0.61 and 0.80 as substantial agreement.\n\nAccessibility judgments are known to vary. In one study, about half of the WCAG 2.0 success criteria fell short of 80 percent agreement among knowledgeable evaluators. Risk-scoring research reports that ordinal scores are rarely tested against outcomes and that raters cluster in the middle of a scale. Multi-criteria analysis forbids counting the same effect twice, because a double-counted effect gets more weight than it deserves.\n\nThree practices follow. Rating anchors are written as facts a reviewer can confirm. Thresholds are the same on every campus. The rubric is piloted against expert judgment, its agreement is measured, and it is re-tested each year. This principle extends the ATI's rule that the standard used to judge the work does not vary by campus.";

// --- 4. Folds ---------------------------------------------------------------------------
MATCH (p:Principle {handle: "principle:deference-earned-through-documented-process"})
WHERE NOT p.description_full CONTAINS "A denial of a purchase is a limit decision"
SET p.description_full = p.description_full + "\n\n" + "A denial of a purchase is a limit decision of the same kind. The CSU procurement process requires a detailed rationale for a recommendation to deny, noted in the IT purchase review system, and expects each campus to define how a requester asks for reconsideration. A denial states the findings it rests on, the threshold it applied, and the route to approval or reconsideration.";

MATCH (p:Principle {handle: "principle:time-bound-alternative-when-not-conformant"})
WHERE NOT p.description_full CONTAINS "A determination that approves a product"
SET p.description_full = p.description_full + "\n\n" + "A determination that approves a product, with or without a plan, also holds for a stated term. The CSU asks that TAAPs be reviewed at least once a year to coincide with the product's renewal. A renewal, a major new version, or a change in who uses the product or how it is used calls for a new determination before the term ends.";

// --- 5. derives_from ---------------------------------------------------------------------
UNWIND [
  {h: "principle:equally-effective-access", g: "a992715018e64d15ba392f7bb09d0c16", kind: "interpretation", provision: "Resolution Agreement, definition of accessible", quote: "A person with a disability must be able to obtain the information as fully, equally, and independently as a person without a disability.", why: "OCR's agreement names independence as a condition of access. An alternative that needs another person's help fails it."},
  {h: "principle:equally-effective-access", g: "6fd44b5e5a544e92bcf1bd8f5ab5d710", kind: "interpretation", provision: "Resolution Agreement, definitions", quote: "means that the alternative format or medium communicates the same information in as timely a fashion as does the original format or medium.", why: "OCR's definition of equally effective makes timing a condition. An alternative delivered later than the original is not equally effective."},
  {h: "principle:equally-effective-access", g: "984b24329c9b405792c5507a1cb8b3f1", kind: "interpretation", provision: "Settlement Agreement, definitions", quote: "is based on (1) timeliness of delivery, (2) accuracy of translation, and (3) delivery in a manner and medium appropriate to the disability of the person.", why: "DOJ's definition of equally effective alternate access lists timeliness, accuracy and a suitable medium as its conditions."},
  {h: "principle:equally-effective-access", g: "88067db6eee14211afd46fda49a20f80", kind: "interpretation", provision: "Defenses and Limitations, Minimal Impact, Key Points", quote: "Minimal impact fails if users must rely on assistance, alternate processes, or workarounds to achieve equivalence.", why: "The CSU reads 28 CFR 35.205 so that an outcome reached only through assistance or a workaround is not substantially equivalent."},
  {h: "principle:program-accessibility-as-proactive-duty", g: "6b105f9e35084861bc2a1c869295d7c2", kind: "interpretation", provision: "2011 FAQ, questions on emerging technology and pilot programs", quote: "Therefore, the legal obligations described in the DCL always apply.", why: "OCR says the obligations apply when no student with a visual impairment is enrolled, and apply to pilot programs of short duration. Planning for accessibility comes before deployment."},
  {h: "principle:program-accessibility-as-proactive-duty", g: "a3f6d01ede894e7e84e7200624a800a2", kind: "interpretation", provision: "Settlement Agreement, deployment of e-book readers", quote: "if it deploys any e-book reading device in a class, it will choose a device that meets the definition of accessibility in Paragraph 8 above", why: "The complaint concerned a small pilot of e-readers in courses. The settlement required an accessible device for any future classroom deployment."},
  {h: "principle:program-accessibility-as-proactive-duty", g: "36cc1ca0c2414eb3a5abfa2c7ad4e3ef", kind: "binding_precedent", provision: "Opinion, description of the district court injunction", quote: "ssess educational materials for accessibility before acquisition and to establish means of providing accessible alternative materials to blind students", why: "The Ninth Circuit binds federal courts in California. The injunction it described required a California college to assess materials before acquiring them. The quote begins mid-word because the opinion's text layer splits the word assess."},
  {h: "principle:program-accessibility-as-proactive-duty", g: "d82997ae08354fe1b30385221415d4b4", kind: "binding_precedent", provision: "Opinion, conclusion", quote: "Because the district court abused its discretion in granting remittitur, we reverse, vacate, and remand with instructions to reinstate the jury's damages award.", why: "Ninth Circuit precedent that binds federal courts in California. Damages were reinstated against a California community college for inaccessible course technology and websites."},
  {h: "principle:bounded-duty-burden-limits", g: "88067db6eee14211afd46fda49a20f80", kind: "interpretation", provision: "Defenses and Limitations, Undue Burden, Key Points", quote: "High cost alone does not establish undue burden.", why: "The CSU reads 28 CFR 35.164 and 35.204 so that cost alone is not enough and all resources available to the program count, not only one unit's."},
  {h: "principle:bounded-duty-burden-limits", g: "b3d714bcdb3d4a0987a6e02c1683a126", kind: "interpretation", provision: "Consent Decree, Undue Burden and Fundamental Alteration Determinations", quote: "(a) the President of Miami or (b) an individual designated by the President and who has budgetary authority after considering all resources available for use in the funding and operation of the service, program, or activity.", why: "DOJ limited who may assert undue burden to the president or a designee with budget authority, after considering all resources, with a written statement."},
  {h: "principle:bounded-duty-burden-limits", g: "34a1e0763aaa4b2c80dfb8cc672fbb36", kind: "interpretation", provision: "Understanding Section 508 Exceptions, E202.6.3", quote: "the agency shall provide individuals with disabilities access to and use of information and data by an alternative means that meets identified needs.", why: "Federal guidance pairs every undue burden or fundamental alteration exception with an alternative means of access."},
  {h: "principle:deference-earned-through-documented-process", g: "6fd44b5e5a544e92bcf1bd8f5ab5d710", kind: "interpretation", provision: "Resolution Agreement, reporting requirements", quote: "The report will include a copy of the procurement procedures, the name, title, and relevant qualifications of the individuals involved in developing the procedures, and the methods the University used to create the procedures.", why: "OCR required the procurement procedures to be reported with the names and qualifications of the people who wrote them. The record is part of the remedy."},
  {h: "principle:deference-earned-through-documented-process", g: "749610aedade4c709d784c10cd36dbb0", kind: "mandate", provision: "Step 3: Review Accessibility", quote: "a detailed rationale for the recommendation will be noted in the IT purchase review system.", why: "The CSU process requires a recorded rationale for a recommendation to deny a purchase, and a campus process for reconsideration."},
  {h: "principle:deference-earned-through-documented-process", g: "34a1e0763aaa4b2c80dfb8cc672fbb36", kind: "interpretation", provision: "Understanding Section 508 Exceptions, E202.6.2", quote: "The responsible agency official shall document in writing the basis for determining that conformance to requirements in the Revised 508 Standards constitute an undue burden on the agency, or would result in a fundamental alteration in the nature of the ICT.", why: "An exception under the 508 Standards stands only on a written basis signed by the responsible official."},
  {h: "principle:vendor-leverage-procurement-as-accessibility-lever", g: "a0323855daac4f5ba8c724a02370843c", kind: "interpretation", provision: "Vendor and contract practices", quote: "Asking vendors to include a warranty in their contracts stating that they comply with certain technical standards and applicable Federal and state accessibility laws.", why: "DOJ lists contract warranties among practices public entities found helpful for vendor content."},
  {h: "principle:vendor-leverage-procurement-as-accessibility-lever", g: "6fd44b5e5a544e92bcf1bd8f5ab5d710", kind: "interpretation", provision: "Resolution Agreement, procurement procedures", quote: "the University shall develop and institute procedures that require the University to purchase or recommend only EITs that will provide the same programs, benefits, and services as they do to individuals without disabilities", why: "OCR required the university to buy accessible by default, with accessible alternatives where an exception applies."},
  {h: "principle:vendor-leverage-procurement-as-accessibility-lever", g: "984b24329c9b405792c5507a1cb8b3f1", kind: "interpretation", provision: "Settlement Agreement, technology procurement", quote: "Language in all technology contracts requiring contractors to warrant their compliance with WCAG 2.0 AA", why: "DOJ required warranty language in every technology contract."},
  {h: "principle:time-bound-alternative-when-not-conformant", g: "984b24329c9b405792c5507a1cb8b3f1", kind: "interpretation", provision: "Settlement Agreement, exceptions", quote: "Whenever an exception is granted, the University must develop a plan to provide equally effective alternate access to the information or service of the technology to students, prospective students, and applicants.", why: "DOJ tied every exception to a plan for alternative access."},
  {h: "principle:proportionate-remedy", g: "75f09ff53f6d44ecb14aba480beedfcf", kind: "interpretation", provision: "ACR Issue Detail Supplement, severity levels", quote: "A critical accessibility failure prevents people with disabilities from accessing or completing core functionality.", why: "GSA's severity scale separates barriers to core functionality from lesser defects. It gives a federal anchor for reserving formal plans for blocking barriers."},
  {h: "principle:conformance-to-an-external-technical-standard", g: "88067db6eee14211afd46fda49a20f80", kind: "interpretation", provision: "Section 508 vs Title II", quote: "Title II governs for the covered web/mobile use.", why: "The CSU assigns the governing standard by kind of technology: WCAG 2.1 AA under Title II for web and mobile, the 508 Standards otherwise."},
  {h: "principle:state-law-adopts-the-federal-standard", g: "88067db6eee14211afd46fda49a20f80", kind: "interpretation", provision: "Section 508 vs Title II", quote: "Section 508 governs.", why: "Where Title II does not reach a technology, such as non-web software or hardware, the CSU applies Section 508 through Government Code 7405."},
  {h: "principle:exposure-sets-scrutiny-not-entitlement", g: "28513850e4794975925f7538fdc096ac", kind: "mandate", provision: "28 CFR 35.130(b)(1)(i)", quote: "Deny a qualified individual with a disability the opportunity to participate in or benefit from the aid, benefit, or service;", why: "The prohibition carries no threshold of users or exposure."},
  {h: "principle:exposure-sets-scrutiny-not-entitlement", g: "6b105f9e35084861bc2a1c869295d7c2", kind: "interpretation", provision: "2011 FAQ, pilot programs", quote: "Does the DCL apply to pilot programs or other school programs that are of short duration?", why: "OCR answers yes. Short or small deployments are not excused."},
  {h: "principle:exposure-sets-scrutiny-not-entitlement", g: "a3f6d01ede894e7e84e7200624a800a2", kind: "interpretation", provision: "Settlement Agreement", quote: "if it deploys any e-book reading device in a class, it will choose a device that meets the definition of accessibility in Paragraph 8 above", why: "A small classroom pilot was enough to require an accessible device."},
  {h: "principle:exposure-sets-scrutiny-not-entitlement", g: "34a1e0763aaa4b2c80dfb8cc672fbb36", kind: "interpretation", provision: "Testing Lifecycle Overview", quote: "At minimum, the testing scope should include public-facing, frequently used, or critical functions.", why: "Exposure legitimately sets how much testing is done. It sets scrutiny, not whether access is owed."},
  {h: "principle:vendor-claims-require-proportionate-validation", g: "34a1e0763aaa4b2c80dfb8cc672fbb36", kind: "interpretation", provision: "Understand Vendor Accessibility Claims", quote: "Whenever possible, purchasers should conduct independent conformance validation testing and evaluation to verify vendor accessibility conformance claims.", why: "Federal guidance treats the ACR as a claim to verify."},
  {h: "principle:vendor-claims-require-proportionate-validation", g: "749610aedade4c709d784c10cd36dbb0", kind: "mandate", provision: "Step 4: Complete Procurement", quote: "Vendor demonstration to validate ACR conformance claims and accessibility roadmap progress", why: "The CSU process lists a validating demonstration among the usual contract requirements."},
  {h: "principle:vendor-claims-require-proportionate-validation", g: "75f09ff53f6d44ecb14aba480beedfcf", kind: "interpretation", provision: "ACR Issue Detail Supplement, guidance for buyers", quote: "Use the Issue Detail Supplement in their evaluation of any ICT products or services.", why: "GSA asks buyers to evaluate issue-level severity, affected groups and workarounds, not only the summary ACR."},
  {h: "principle:vendor-claims-require-proportionate-validation", g: "38ab4b6ac47f4b8a8f258387e10d7c2d", kind: "design_choice", provision: "DHS Trusted Tester Process", quote: "The DHS Trusted Tester Process is a manual test approach that aligns with the ICT Testing Baseline, and provides repeatable and reliable conformance test results.", why: "A named, repeatable method is one way to meet the higher evidence levels."},
  {h: "principle:vendor-claims-require-proportionate-validation", g: "631325576e294cc39585594a7f757183", kind: "scholarship", provision: "Abstract", quote: "approximately 50% of success criteria fail to meet the 80% agreement threshold", why: "Even expert evaluation varies, so validation needs a stated method."},
  {h: "principle:most-accessible-product-that-meets-the-need", g: "d072e0621c544cd9b08c1f739574c44d", kind: "mandate", provision: "E202.7 Best Meets", quote: "If products are commercially available that meet some but not all of the standards, the agency must procure the product that best meets the standards.", why: "Binds the CSU through Government Code 7405, with documentation of market research and an alternative means of access."},
  {h: "principle:most-accessible-product-that-meets-the-need", g: "749610aedade4c709d784c10cd36dbb0", kind: "mandate", provision: "Step 1: Gather Information", quote: "Select the most accessible product/service that meets requirements", why: "The CSU process puts the duty on the purchase requester."},
  {h: "principle:most-accessible-product-that-meets-the-need", g: "984b24329c9b405792c5507a1cb8b3f1", kind: "interpretation", provision: "Settlement Agreement, technology procurement", quote: "If a product is available and meets some, but not all, of the relevant accessibility provisions of WCAG 2.0 AA, the product that best meets the standard must be procured.", why: "DOJ applied the best-meets rule to a public university."},
  {h: "principle:most-accessible-product-that-meets-the-need", g: "b3d714bcdb3d4a0987a6e02c1683a126", kind: "interpretation", provision: "Consent Decree, Technology Procurement", quote: "In determining which product best meets the relevant accessibility standards, Miami may take into account a contractual commitment from the vendor to make any non-conforming web technology or software conform or best conform to such standards before Miami makes the product available for use by students.", why: "The decree applies the best-meets test and lets a vendor's contractual commitment count in the comparison."},
  {h: "principle:duty-runs-through-contracts", g: "28513850e4794975925f7538fdc096ac", kind: "mandate", provision: "28 CFR 35.200(b)", quote: "Web content that a public entity provides or makes available, directly or through contractual, licensing, or other arrangements;", why: "The web rule covers content provided through a vendor."},
  {h: "principle:duty-runs-through-contracts", g: "99d4a68d95e7413eac49fb5c8083bf2a", kind: "mandate", provision: "34 CFR 104.4(b)(1)", quote: "A recipient, in providing any aid, benefit, or service, may not, directly or through contractual, licensing, or other arrangements, on the basis of handicap:", why: "Section 504 carries the same reach for recipients of federal funds."},
  {h: "principle:duty-runs-through-contracts", g: "a0323855daac4f5ba8c724a02370843c", kind: "interpretation", provision: "Vendor and contract practices", quote: "Your public entity needs to make sure that any content or mobile apps a vendor or contractor provides or posts on its behalf complies with WCAG 2.1 Level AA.", why: "DOJ states the vendor duty directly."},
  {h: "principle:duty-runs-through-contracts", g: "a992715018e64d15ba392f7bb09d0c16", kind: "interpretation", provision: "Resolution Agreement, EIT plan", quote: "This procedure should direct administrators and staff to ensure that any University acquisition or use of EIT and third-party websites, services, or products will provide equal opportunity", why: "OCR applied the duty to third-party products the university acquires."},
  {h: "principle:same-facts-same-answer", g: "631325576e294cc39585594a7f757183", kind: "scholarship", provision: "Abstract", quote: "Further, testability of WCAG 2.0 criteria is achieved if 80% of knowledgeable inspectors agree that the criteria has been met or not.", why: "Sets an agreement threshold for accessibility judgments and shows many criteria fall short of it."},
  {h: "principle:same-facts-same-answer", g: "ade74663a66540a7bba52629ed4cadbc", kind: "scholarship", provision: "5.4.4.5 Double counting", quote: "double counting should not be allowed in MCA, since double- counted effects are likely to be given more weight in the final overall decision than they deserve.", why: "Overlapping factors must be merged before scoring. The hyphen break in the quote is in the manual's text layer."},
  {h: "principle:same-facts-same-answer", g: "9785c9fd80b4412fb88537ec32dd7d02", kind: "scholarship", provision: "Chapter on reliability", quote: null, why: "Sets the convention of relying on alpha of 0.800 or higher. No source text is held; the book is not open access."},
  {h: "principle:same-facts-same-answer", g: "6ff7d95286de40ecb763c831c8522400", kind: "scholarship", provision: "Benchmark scale for kappa", quote: null, why: "Gives the conventional interpretation bands for agreement. No source text is held."},
  {h: "principle:same-facts-same-answer", g: "f5a21c55f86b4435ba0f9650401b159a", kind: "scholarship", provision: "Critique of ordinal scoring", quote: null, why: "Ordinal scores are rarely tested against outcomes, and raters cluster in the middle of a scale. No source text is held."}
] AS row
MATCH (p:Principle {handle: row.h})
MATCH (g {unique_id: row.g})
MERGE (p)-[r:derives_from]->(g)
ON CREATE SET r.grounding_kind = row.kind, r.provision = row.provision, r.quote = row.quote,
              r.rationale = row.why, r.assessed_date = date("2026-10-16");

// --- 6. contested_by -----------------------------------------------------------------------
UNWIND [
  {h: "principle:prioritization-by-impact", g: "45ad1531fbb14e7899c672fef755ce90", provision: "The risk matrix theorem", quote: null, why: "Cox shows that a risk matrix can correctly compare only a small share of pairs of risks and can rank a smaller risk above a larger one. The source does not reject prioritizing by impact. It contests the ordinal impact-by-likelihood matrix as the method, which is the form the ATI Prioritization Framework takes. No source text is held; the article is paywalled."},
  {h: "principle:prioritization-by-impact", g: "c2b287458bdb42b3b7a8c6cb5fdb43f4", provision: "Summary and conclusions", quote: null, why: "The authors find that the design choices in a risk matrix, such as bin edges and scale direction, change its rankings, and that no published evidence shows matrices improve decisions. It contests the matrix as the method, not prioritizing by impact. The stored text came from a PDF whose text layer is letter-spaced, so no quote is taken from it."},
  {h: "principle:prioritization-by-impact", g: "9985d340a6174ce99261506fb79aa999", provision: "Abstract", quote: "Among those 24 discussed problems are ordinal scales, semi-quantitative arithmetics, range compression, risk inversion, ambiguity, and neglection of uncertainty.", why: "Krisper catalogues the problems of scoring with ordinal risk matrices. It contests the method used to prioritize, not prioritizing by impact."}
] AS row
MATCH (p:Principle {handle: row.h})
MATCH (s:IntellectualSource {unique_id: row.g})
MERGE (p)-[r:contested_by]->(s)
ON CREATE SET r.provision = row.provision, r.quote = row.quote, r.rationale = row.why,
              r.assessed_date = date("2026-10-16");
