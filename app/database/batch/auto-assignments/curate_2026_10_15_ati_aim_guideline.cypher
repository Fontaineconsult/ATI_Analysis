// =====================================================================================
// Governance: CSU ATI Accessible Instructional Materials, as a Guideline.
// Run 2026-10-15 by Daniel Fontaine.
//
// WHAT THIS ADDS
//   The Chancellor's Office faculty guide at https://ati.calstate.edu/accessible-instructional-materials and its five
//   subpages. It is systemwide guidance, so it is a Guideline (Governance), not campus
//   Guidance evidence. Same shape as the "CSU ATI Procurement Process" Guideline: one
//   Guideline, is_sourced_from each Webpage, page text stored on the Webpages.
//
// SECTIONS
//   A. The Guideline node.
//   B. Six Webpages with raw_text (captured 2026-10-15), each linked by is_sourced_from.
//   C. drives edges to five -ins indicators (strong matches only), each with provision,
//      a verbatim quote from the stored raw_text, and a note.
//
// HOW THE TEXT WAS CAPTURED
//   The site returns 403 to non-browser clients. Access was confirmed in Chrome; the HTML
//   was fetched with a browser user agent and the <main> content converted to Markdown.
//   Collapsed accordion content (the eight steps) is included. A urldefense-wrapped
//   Eventbrite link was unwrapped to its target.
//
// NOT DONE HERE
//   - The campus support directory page (find-accessibility-support-your-campus).
//   - Moderate indicator matches: 5.11-ins, 8.12-ins, 8.14-ins, 7.3-ins.
//   - A Service node for the CSU PDF remediation service.
//
// VALIDATE FIRST
//   python -m app.database.cypher_runner.run_file app/database/batch/auto-assignments/curate_2026_10_15_ati_aim_guideline.cypher
//   python -m app.database.cypher_runner.run_file app/database/batch/auto-assignments/curate_2026_10_15_ati_aim_guideline.cypher --execute
// =====================================================================================

// ---------------------------------------------------------------- A. Guideline
MERGE (g:Guideline {title: "CSU ATI Accessible Instructional Materials"})
  ON CREATE SET g.unique_id = replace(randomUUID(), '-', '')
SET g.description = "The Chancellor's Office guide for faculty on accessible instructional materials. It gives eight course practices, training and the Faculty Community of Practice, tools for finding and fixing barriers, the WCAG 2.1 AA standard with a way to prioritize work, and a faculty FAQ.";

// ---------------------------------------------------------------- B. Webpages
MATCH (g:Guideline {title: "CSU ATI Accessible Instructional Materials"})
MERGE (w:Webpage {url: "https://ati.calstate.edu/accessible-instructional-materials"})
  ON CREATE SET w.unique_id = replace(randomUUID(), '-', ''),
                w.include_in_report = true, w.depreciated = false, w.no_longer_exists = false
SET w.name = "Accessible Instructional Materials",
    w.description = "The hub page. It directs faculty to the eight course practices, training, tools, the WCAG standard and the faculty FAQ.",
    w.raw_text = "# Accessible Instructional Materials\nAccessible instructional materials are integral to equity, diversity, inclusion, and belonging. Designing for accessibility creates a more equitable learning environment that benefits all students.\nNew to this work? Start with the 8 steps to a more accessible course, or find accessibility support at your campus.\n#### Start with your current course\n- Prioritize the syllabus, assignments, assessments, weekly instructions, required readings, and required videos.\n- Fix simple barriers, replace poor source material, and rebuild high-use content when needed.\n- Use automated checkers, then review the results with human judgment.\n## Four habits that improve access now\nYou don't need a complete course rebuild to make progress. Focus on high-impact materials, improve content as you touch it, and respond promptly when a student encounters a barrier.\n- Check before publishing. Review headings, links, images, videos, and files before students need them.\n- Prefer accessible pages. Convert frequently used PDFs and documents into accessible Canvas pages when practical.\n- Ask for help early. Contact instructional technology, accessibility, library, or disability services partners instead of delaying a fix.\n- Respond to barriers. Provide an accessible alternative promptly and improve the source material for future students.\n## Choose the task you need to complete\nReview the 8 steps\nBuild a more accessible course\nUse eight concrete practices for structure, images, links, media, readings, documents, Canvas pages, and accessibility checkers.\nExplore training and community\nLearn with colleagues\nFind on-demand training, live webinars, office hours, and the Faculty Community of Practice.\nExplore tools and remediation\nUse available tools\nLearn how course checkers, document checkers, captioning tools, and PDF remediation can support your work.\nReview standards and priorities\nUnderstand the standard\nReview WCAG, the POUR principles, content likely to need attention, and a practical prioritization approach.\nConnect with campuses\nConnect with campus support\nFind instructional materials resources and contacts at your university.\nRead faculty FAQs\nGet a focused answer\nFind guidance on current courses, older PDFs, third-party content, reported barriers, and automated tools.\n## Join the Faculty Community of Practice\nThe virtual Faculty Community of Practice is a space to ask questions, share effective practices, and align campus work with systemwide accessibility goals. It meets on Zoom the first Thursday of scheduled months.\nSee the meeting schedule and how to join\n#### When a student reports a barrier\nThank the student, provide an accessible alternative as soon as practical, coordinate support, and correct the source so the barrier does not recur.\n\n## Links on this page\n\n- 8 steps to a more accessible course (https://ati.calstate.edu/accessible-instructional-materials/8-steps-more-accessible-course)\n- find accessibility support at your campus (https://ati.calstate.edu/accessible-instructional-materials/find-accessibility-support-your-campus)\n- Review the 8 steps (https://ati.calstate.edu/accessible-instructional-materials/8-steps-more-accessible-course)\n- Explore training and community (https://ati.calstate.edu/accessible-instructional-materials/build-accessibility-skills-flexible-training-and-community)\n- Explore tools and remediation (https://ati.calstate.edu/accessible-instructional-materials/use-tools-find-barriers-speed-fixes-and-track-progress)\n- Review standards and priorities (https://ati.calstate.edu/accessible-instructional-materials/understand-accessibility-standard-and-prioritize-work)\n- Connect with campuses (https://ati.calstate.edu/accessible-instructional-materials/find-accessibility-support-your-campus)\n- Read faculty FAQs (https://ati.calstate.edu/accessible-instructional-materials/faculty-faq)\n- See the meeting schedule and how to join (https://ati.calstate.edu/accessible-instructional-materials/build-accessibility-skills-flexible-training-and-community)\n",
    w.raw_text_captured = date("2026-10-15")
MERGE (g)-[r:is_sourced_from]->(w)
  ON CREATE SET r.added_date = date("2026-10-15");

MATCH (g:Guideline {title: "CSU ATI Accessible Instructional Materials"})
MERGE (w:Webpage {url: "https://ati.calstate.edu/accessible-instructional-materials/8-steps-more-accessible-course"})
  ON CREATE SET w.unique_id = replace(randomUUID(), '-', ''),
                w.include_in_report = true, w.depreciated = false, w.no_longer_exists = false
SET w.name = "8 steps to a more accessible course",
    w.description = "Eight practices for an accessible course: structure, alt text, links, captions, reading formats, documents, Canvas pages and accessibility checkers.",
    w.raw_text = "# 8 steps to a more accessible course\nUse these practices while creating or updating course materials. Start with content students need now, then improve frequently reused materials over time.\n## Accessible course highlights\n- Before publishing: check headings, links, images, videos, and files.\n- When updating: convert frequently used PDFs and documents into accessible Canvas pages where practical.\n- When unsure: contact campus instructional technology, accessibility, library, or disability services partners.\n- When a student reports a barrier: respond promptly, provide an accessible alternative, and improve the source material.\n### On this page\n- Structure and formatting\n- Alternative text\n- Descriptive links\n- Captions and transcripts\n- Reading formats\n- Accessible documents\n- Canvas pages over files\n- Accessibility checkers\nUse proper structure and formatting\nWhy it matters: Screen reader users, keyboard users, and students using mobile devices rely on real headings, lists, and tables to understand organization. Visual formatting alone does not communicate structure to assistive technology.\nApply\n- Use built-in heading styles in Word, PowerPoint, Canvas, and Google Docs. Inside a Canvas page, begin main sections with Heading 2 and use Heading 3 for subsections; do not skip levels for visual effect.\n- Use real bulleted and numbered lists instead of manually typed bullets, hyphens, or numbers.\n- Use tables only for data, not layout. Include a clear header row and keep tables simple.\n- Use short paragraphs, meaningful section titles, and consistent formatting.\n- Use paragraph spacing or styles instead of extra blank lines.\nExamples\n- A Canvas page with “Read,” “Watch,” “Practice,” and “Submit” section headings.\n- A syllabus with true headings for Course Description, Learning Outcomes, Weekly Schedule, Grading, and Policies.\nQuick check\nOpen the document or Canvas page in the navigation pane, outline view, or accessibility checker. If there is no meaningful outline, the content probably needs real headings.\nAdd alternative text to images\nWhy it matters: Alternative text provides a text equivalent for meaningful images. The goal is to communicate the educational purpose of the image in context, not describe every pixel.\nApply\n- Describe the meaning or instructional purpose of the image, not only its appearance.\n- Keep alt text concise for simple images; one or two sentences is usually enough.\n- For charts, diagrams, maps, or complex images, use a brief alt text summary and provide the full explanation in nearby text or a linked long description.\n- Mark images as decorative, or leave alt text blank, only when they add no instructional meaning.\n- Avoid “image of” or “picture of” unless the medium itself matters.\nExamples\n- Nursing photo: “Student demonstrates proper hand placement for adult CPR chest compressions.”\n- Line chart: “Line chart showing enrollment increasing steadily from 2019 through 2024; full data table follows.”\nQuick check\nAsk: What would a student miss if this image did not load or could not be seen? Put that answer in the alt text or nearby text.\nMake links descriptive and meaningful\nWhy it matters: Students using screen readers may navigate with a list of links. “Click here” and raw URLs do not give enough context.\nApply\n- Use link text that names the destination or action: “Read the lab safety guidelines,” not “click here.”\n- Avoid long raw URLs unless students must copy the URL.\n- Identify the file type when useful, such as “Download the final project rubric (PDF).”\n- Make links visually distinguishable without relying on color alone.\n- Review links each term and remove broken or outdated resources.\nExamples\n- “Submit the accessibility reflection survey”\n- “Review the Week 3 case study instructions (Word document)”\nQuick check\nRead each link out of context. If its destination is still clear, the link text is likely descriptive.\nCaption videos and provide transcripts\nWhy it matters: Captions and transcripts support students who are deaf or hard of hearing, multilingual students, students in noisy environments, and students who prefer reading or searching text.\nApply\n- Use accurate closed captions for prerecorded video. Auto-captions are a starting point and should be reviewed and corrected.\n- Provide transcripts for audio-only materials such as podcasts, interviews, and recorded lectures.\n- Describe important visual information in narration, the transcript, or nearby page text when it is not explained aloud.\n- Choose third-party videos with reliable captions when available.\n- For live sessions, coordinate captioning or transcription through campus processes and accommodation support.\nExamples\n- A lecture recording with edited captions and a downloadable transcript.\n- A YouTube video whose captions were checked before assignment.\nQuick check\nPlay a short section with captions on. Check names, technical terms, punctuation and grammar, dates, and key concepts.\nProvide multiple ways to access reading materials\nWhy it matters: Students use different devices, assistive technologies, bandwidth levels, and learning preferences. Flexible formats reduce barriers.\nApply\n- Use library reading lists, permalinks, or accessible HTML versions when available.\n- Prefer born-digital, searchable text over scanned image PDFs.\n- Provide formats such as HTML, tagged PDF, EPUB, audio, or Word when appropriate and supported by campus tools.\n- Avoid readings that are rotated, blurry, low contrast, or missing selectable text.\n- Work with library, disability services, or instructional technology staff for difficult readings, copyright questions, and remediation workflows.\nExamples\n- A library reading list that links to accessible publisher or database versions.\n- A Canvas page that summarizes reading tasks and links to accessible article versions.\nQuick check\nTry selecting text and searching for a keyword. If neither works, the reading may be a scan that needs OCR or replacement.\nCreate accessible documents before uploading\nWhy it matters: Accessibility is easiest to build into the source file. Remediating a PDF after export is usually harder than creating an accessible Word, PowerPoint, or Google file from the beginning.\nApply\n- Run the Word and PowerPoint accessibility checkers before uploading.\n- Use real headings, slide titles, lists, table headers, alternative text, and logical reading order.\n- Use sufficient color contrast and avoid color-only instructions.\n- Name files clearly and consistently, such as “Week 04 Lab Instructions.docx.”\n- Export PDFs from accessible source documents when necessary; avoid printing to PDF because it can remove accessibility information.\nExamples\n- Confirm every lecture slide has a unique title and logical reading order.\n- Run the accessibility checker on a handout and resolve critical issues before posting.\nResources\n- Read: Make your Word documents accessible (Microsoft)\n- Watch: Create more accessible Word documents (Microsoft)\n- Read: Make your PowerPoint presentations accessible (Microsoft)\n- Watch: Create more accessible PowerPoint presentations (Microsoft)\nUse Canvas pages over files when possible\nWhy it matters: Canvas pages are often easier to update, use on mobile devices, and navigate with assistive technology than downloadable files.\nApply\n- Convert short instructions, weekly overviews, policies, and assignment prompts into Canvas pages instead of PDF attachments.\n- Use the Rich Content Editor for headings, lists, descriptive links, tables, and image alt text.\n- Break long pages into clearly labeled sections or modules.\n- Use Canvas pages for content that changes often, including schedules, office hours, and assignment directions.\n- Keep downloadable files when students need to annotate, print, complete a worksheet, or use a specialized format.\nExamples\n- Create the syllabus directly in Canvas so revisions can be made in one place.\n- Create weekly module pages with objectives, readings, videos, activities, and due dates.\nExample from the source document: moving syllabus content from a Word file into a Canvas page.\nResources\n- How do I use the Syllabus as an instructor?\n- How do I add course content as module items?\n- How do I create a new page in a course?\n- Beginner’s guide to accessibility with the Canvas Rich Content Editor\n- How do I use the Accessibility Checker in the Rich Content Editor?\nCheck and improve accessibility with UDOIT or Ally\nWhy it matters: Automated checkers can find common issues quickly, but they do not replace human review. Use them as a routine quality check.\nApply\n- Run the supported Canvas accessibility checker before publishing new pages.\n- Use UDOIT or Ally, where available, to identify missing headings, missing image alt text, poor link text, inaccessible tables, and file issues.\n- Fix issues directly when the tool offers a reliable fix; request help for complex files or repeated problems.\n- Use course reports to prioritize high-enrollment, current, and frequently reused content.\n- Track progress over time rather than treating accessibility as a one-time cleanup project.\nExamples\n- Run UDOIT after importing a course into a new term.\n- Use Ally alternate format indicators to identify files that may need replacement or remediation.\n\n## Links on this page\n\n- Read: Make your Word documents accessible (Microsoft) (https://support.office.com/en-us/article/Make-your-Word-documents-accessible-d9bf3683-87ac-47ea-b91a-78dcacb3c66d)\n- Watch: Create more accessible Word documents (Microsoft) (https://support.office.com/en-us/article/9d660cba-1fcd-45ad-a9d1-c4f4b5eb5b7d)\n- Read: Make your PowerPoint presentations accessible (Microsoft) (https://support.office.com/en-US/article/Make-your-PowerPoint-presentations-accessible-6f7772b2-2f33-4bd2-8ca7-dae3b2b3ef25)\n- Watch: Create more accessible PowerPoint presentations (Microsoft) (https://support.office.com/en-us/article/794fc5da-f686-464d-8c29-1c6ab8515465)\n- How do I use the Syllabus as an instructor? (https://community.canvaslms.com/t5/Instructor-Guide/How-do-I-use-the-Syllabus-as-an-instructor/ta-p/638)\n- How do I add course content as module items? (https://community.canvaslms.com/t5/Instructor-Guide/How-do-I-add-course-content-as-module-items/ta-p/1157)\n- How do I create a new page in a course? (https://community.canvaslms.com/t5/Instructor-Guide/How-do-I-create-a-new-page-in-a-course/ta-p/1031)\n- Beginner’s guide to accessibility with the Canvas Rich Content Editor (https://community.canvaslms.com/t5/Higher-Ed-Canvas-Users/Beginner-s-Accessibility-with-the-Rich-Content-Editor/ba-p/272937)\n- How do I use the Accessibility Checker in the Rich Content Editor? (https://community.canvaslms.com/t5/Instructor-Guide/How-do-I-use-the-Accessibility-Checker-in-the-Rich-Content/ta-p/820)\n",
    w.raw_text_captured = date("2026-10-15")
MERGE (g)-[r:is_sourced_from]->(w)
  ON CREATE SET r.added_date = date("2026-10-15");

MATCH (g:Guideline {title: "CSU ATI Accessible Instructional Materials"})
MERGE (w:Webpage {url: "https://ati.calstate.edu/accessible-instructional-materials/build-accessibility-skills-flexible-training-and-community"})
  ON CREATE SET w.unique_id = replace(randomUUID(), '-', ''),
                w.include_in_report = true, w.depreciated = false, w.no_longer_exists = false
SET w.name = "Build accessibility skills with flexible training and community support",
    w.description = "The 8 Steps webinar and the systemwide Faculty Community of Practice, which meets on Zoom the first Thursday of the month.",
    w.raw_text = "# Build accessibility skills with flexible training and community support\nLearn at your own pace, join a live session, get practical help during office hours, or connect with faculty colleagues across the CSU.\n## Ways to learn\n### WebAIM accessible document training\nSelf-paced online course from WebAIM, offered through the CSU Accessible Technology Initiative. Learn to create accessible Word, PowerPoint, and PDF files.\nRegister for WebAIM document training\n### Office hours\nBring your accessibility questions and get practical help with your course materials.\nWill be added soon\n### CAST training\nOn-demand training from CAST, the organization behind Universal Design for Learning (UDL).\nWill be added soon\n### Accessible Instructional Materials webinar\nLive webinar for faculty creating and updating digital instructional materials.\nSignup for the Accessible Instructional Materials webinar\n### 8 Steps to a More Accessible Course webinar\nLive webinar that walks through the 8-step faculty checklist used throughout this site.\nSign up for the 8-Steps to a More Accessible Course webinar\n### Faculty Community of Practice\nMonthly virtual meeting where faculty share practices and solve accessibility problems together.\nSee meeting details at bottom of page\n## Faculty Community of Practice: Digital Accessibility\nFaculty use digital instructional materials every day, and the ADA Title II rule makes accessible content a requirement. The Community of Practice supports the CSU commitment to accessibility, equity, and compliance with federal and state accessibility requirements.\nEach meeting focuses on one digital instructional materials topic, with time to ask questions, share practices, and build alignment with systemwide accessibility goals.\n### What to expect\n- A different accessibility topic at each meeting.\n- Time for faculty questions and shared problem-solving.\n- Practical examples that support accessible classrooms across the CSU.\n### Meeting details\n- When: First Thursday of the month, 11:00 a.m. to 12:00 p.m. (Pacific)\n- Where: Zoom\nNote: The Faculty Instructional Material Community of Practice Zoom link will be shared once registered.\n\n## Links on this page\n\n- Register for WebAIM document training (https://ati.calstate.edu/systemwide-tools-training/accessible-document-training)\n- Signup for the Accessible Instructional Materials webinar (https://www.eventbrite.com/e/accessible-instructional-materials-webinar-tickets-2001404797626)\n- Sign up for the 8-Steps to a More Accessible Course webinar (https://www.eventbrite.com/e/8-steps-to-a-more-accessible-course-tickets-2001411093457)\n",
    w.raw_text_captured = date("2026-10-15")
MERGE (g)-[r:is_sourced_from]->(w)
  ON CREATE SET r.added_date = date("2026-10-15");

MATCH (g:Guideline {title: "CSU ATI Accessible Instructional Materials"})
MERGE (w:Webpage {url: "https://ati.calstate.edu/accessible-instructional-materials/use-tools-find-barriers-speed-fixes-and-track-progress"})
  ON CREATE SET w.unique_id = replace(randomUUID(), '-', ''),
                w.include_in_report = true, w.depreciated = false, w.no_longer_exists = false
SET w.name = "Use tools to find barriers, speed up fixes, and track progress",
    w.description = "Tool categories for checking course content, UDOIT how-to resources, and the CSU PDF remediation service with its limits.",
    w.raw_text = "# Use tools to find barriers, speed up fixes, and track progress\nTool availability varies by campus and systemwide license. Use automated results as a starting point, then check instructional quality yourself.\nExplore CSU systemwide accessibility tools\n## Common tool categories\nCampuses may provide some or all of the following tools and services.\n### Canvas course tools\nUDOIT, Ally, TidyUp, and the Canvas Rich Content Editor Accessibility Checker.\n### Document tools\nMicrosoft 365 Accessibility Checker, Adobe Acrobat Pro Accessibility Checker, GrackleDocs for Google Workspace, and campus PDF remediation tools.\n### Captioning and media\nKaltura, Verbit, Otter.ai, and campus captioning request workflows.\n### Web and content evaluation\nPopeTech, WAVE, WebAIM Color Contrast Checker, and Drupal accessibility checkers where available.\n### Assistive technology\nJAWS, ZoomText, Fusion, Immersive Reader, speech recognition tools, and other testing or student support technologies.\n### Campus guidance matters\nLicenses, workflows, and supported remediation services differ. Confirm the campus process before relying on a specific product.\n#### Check your campus process first\nLicenses, workflows, and remediation services differ by campus. Confirm what your campus supports before relying on a specific product. Find your campus support contacts.\n## Review your Canvas course\nCourse checkers such as UDOIT, Ally, TidyUp, and the Rich Content Editor checker find common issues in Canvas pages and files. Use course reports to prioritize current, high-enrollment, and frequently reused content.\n- Run your campus's supported checker before publishing new pages.\n- Fix reliable, straightforward issues directly in the tool.\n- Request help for complex files, repeated problems, or issues that need instructional judgment.\n- Track improvement over time rather than treating accessibility as a one-time project.\n### UDOIT how-to resources\n- Use UDOIT in Canvas to make images accessible\n- Use UDOIT to identify which uploaded files are accessible\n- View the Canvas course UDOIT Scorecard\nExample UDOIT course scorecard included in the source document\n## PDF accessibility remediation\nThe CSU PDF remediation service, part of the ATI Remediation Framework, uses AI to address many common accessibility issues. It can improve a document substantially, but it does not guarantee a fully accessible PDF, and some files will need targeted manual work.\n### How it works\n- Upload a document. Log in through the university portal and upload a PDF that meets the file-size and page-limit requirements.\n- Run remediation. The service addresses issues such as missing tags, reading order, alt text, and table structure.\n- Download and review. Download the processed PDF and accessibility reports, then review what was addressed and what still needs attention.\nLog in to begin PDF remediation\n#### Manual verification is still required\n- The service does not fix fillable forms.\n- Color contrast and logical reading order need manual checks.\n- Complex layouts may need additional refinement.\n- Verify every file before using it in instruction.\nBest practices before you upload\n- Start with the original Word, PowerPoint, or other source file.\n- Apply headings, alt text, color contrast, and table structure before converting.\n- Export to PDF from the accessible source file. Don't print to PDF.\n- Use the remediation app to streamline final improvements.\nGet help with complex or high-priority files\nPlease contact your campus instructional materials support team using the Campus Support Directory for your campus.\n\n## Links on this page\n\n- Explore CSU systemwide accessibility tools (https://ati.calstate.edu/systemwide-tools)\n- Find your campus support contacts (https://ati.calstate.edu/accessible-instructional-materials/find-accessibility-support-your-campus)\n- Use UDOIT in Canvas to make images accessible (https://cidilabs.instructure.com/courses/6621/pages/fixing-accessibility-issues-in-your-canvas-content?module_item_id=170128)\n- Use UDOIT to identify which uploaded files are accessible (https://cidilabs.instructure.com/courses/6621/pages/making-your-files-more-accessible?module_item_id=239072)\n- View the Canvas course UDOIT Scorecard (https://cidilabs.instructure.com/courses/6621/pages/enabling-udoit-in-a-course?module_item_id=240250)\n- Log in to begin PDF remediation (https://csu.d2ljzoawo09xv6.amplifyapp.com/home)\n- Campus Support Directory (https://ati.calstate.edu/accessible-instructional-materials/find-accessibility-support-your-campus)\n",
    w.raw_text_captured = date("2026-10-15")
MERGE (g)-[r:is_sourced_from]->(w)
  ON CREATE SET r.added_date = date("2026-10-15");

MATCH (g:Guideline {title: "CSU ATI Accessible Instructional Materials"})
MERGE (w:Webpage {url: "https://ati.calstate.edu/accessible-instructional-materials/understand-accessibility-standard-and-prioritize-work"})
  ON CREATE SET w.unique_id = replace(randomUUID(), '-', ''),
                w.include_in_report = true, w.depreciated = false, w.no_longer_exists = false
SET w.name = "Understand the accessibility standard and prioritize the work",
    w.description = "WCAG 2.1 AA under the Title II rule, the April 26, 2027 compliance date, the POUR principles, and the fix, replace, or rebuild decision.",
    w.raw_text = "# Understand the accessibility standard and prioritize the work\nWCAG—Web Content Accessibility Guidelines—is the technical standard used to define whether web content is accessible to people with disabilities. The source document states that the DOJ Title II Final Rule requires public institutions to meet WCAG 2.1 AA.\n#### Compliance date\nAn interim final rule issued April 20, 2026 moved the compliance date for large public entities such as the CSU to April 26, 2027. The requirements themselves did not change, so keep improving course materials now.\n## The four big ideas: POUR\nUse these principles to evaluate web pages, documents, images, video, audio, forms, and third-party tools used in instruction.\nPerceivable\nCan students get the information in a form they can perceive?\n- Add text alternatives for meaningful images.\n- Do not rely on color alone.\n- Caption videos\nOperable\nCan students navigate and complete tasks using different input methods?\n- Make mouse actions work by keyboard.\n- Avoid flashing more than three times per second.\n- Give people enough time to read and interact.\nUnderstandable\nCan students understand the content, instructions, and interface behavior?\n- Use plain language.\n- Define acronyms and technical terms.\n- Keep layouts and navigation predictable.\nRobust\nDoes the content work with current and future assistive technologies?\n- Use proper HTML.\n- Support screen readers and voice control.\n- Avoid inaccessible scanned PDFs.\n### Content to Likely Require Attention\n- Canvas pages, modules, assignments, quizzes, discussions, rubrics, and syllabus content.\n- Word, PowerPoint, PDF, spreadsheet, and Google Workspace files.\n- Videos, lecture recordings, podcasts, audio feedback, and other media.\n- Images, charts, diagrams, maps, infographics, and scanned readings.\n- Publisher platforms, homework systems, simulations, library materials, and third-party instructional tools.\n- Announcements, emails, flyers, social media posts, and event materials.\n### How to prioritize\n- Start with high-impact items students need now: syllabus, assignments, assessments, weekly instructions, required readings, required videos, and current communications.\n- Build accessibility into new materials at the point of creation.\n- Use Canvas pages for short web content when students do not need a downloadable file.\n- Replace inaccessible content when an accessible library or publisher version already exists.\n- Use automated checkers to find common issues, then apply human judgment.\n- Document repeated barriers and request help for complex PDFs, multimedia, STEM notation, and vendor tools.\n## Use the “fix, replace, or rebuild” decision\nChoose the approach that gives students the best access with the least avoidable work.\n### Fix\nCorrect straightforward issues directly, such as heading structure, link text, alt text, or caption errors.\n### Replace\nSwap poor-quality scans or inaccessible PDFs for an accessible source, database, publisher, or library version.\n### Rebuild\nRecreate heavily used materials as Canvas pages or accessible source documents when remediation would be inefficient or unreliable.\n## What automated tools can and can't tell you\n#### Tools can find\nMany missing headings, missing alt text, poor link text, color contrast issues, table header problems, and some document issues.\n#### People still need to check\nWhether alt text is meaningful, captions are accurate, PDF reading order makes sense, instructions are clear, and every learning activity has an accessible equivalent.\n",
    w.raw_text_captured = date("2026-10-15")
MERGE (g)-[r:is_sourced_from]->(w)
  ON CREATE SET r.added_date = date("2026-10-15");

MATCH (g:Guideline {title: "CSU ATI Accessible Instructional Materials"})
MERGE (w:Webpage {url: "https://ati.calstate.edu/accessible-instructional-materials/faculty-faq"})
  ON CREATE SET w.unique_id = replace(randomUUID(), '-', ''),
                w.include_in_report = true, w.depreciated = false, w.no_longer_exists = false
SET w.name = "Faculty FAQ",
    w.description = "Faculty answers on what to fix first, content they did not create, older PDFs, reported barriers, and what automated tools miss.",
    w.raw_text = "# Faculty FAQ\nDigital Accessibility FAQ\nUse these answers to decide what to address first, how to work with content you did not create, and when to request support\nWhat should I focus on first?\nBegin with the current course where students are enrolled. Prioritize content students must use to understand expectations, complete graded work, or participate in class.\nA practical order is: syllabus, module overviews, assignment instructions, quizzes and exams, required readings, required videos, and recurring course communications. For future planning, prepare upcoming-term materials before older content that is not currently used.\nHow should I prioritize content remediation?\nPrioritize materials that are required, high-stakes, reused, shared, or difficult to replace quickly. Examples include common syllabi, program handbooks, shared rubrics, digital textbooks, lab manuals, frequently used slide decks, and materials used across multiple sections.\nUse the “fix, replace, or rebuild” decision: fix simple issues, replace poor-quality scans or inaccessible PDFs with accessible source versions, and rebuild heavily used materials as Canvas pages or accessible source documents.\nHow should I approach content I did not create?\nFor publisher materials, select accessible platforms and request accessibility documentation such as a VPAT or accessibility conformance report. Report barriers to the publisher and campus procurement or accessibility contacts.\nFor library materials, ask library colleagues to locate accessible database versions, permalinks, EPUB versions, OCR text, captioned media, or alternate formats.\nFor online videos, articles, images, and open-web resources, choose accessible alternatives when available. When an essential resource is inaccessible, provide an accessible equivalent or work with campus support to remediate it.\nDo all old PDFs have to be remediated immediately?\nNot every old file has the same priority, but current instructional use matters. A PDF actively used in a current course, required for participation, or needed for graded work should be accessible or replaced with an accessible equivalent.\nSome archived web content may qualify for an exception only under specific conditions, but effective communication and equal access still matter when a person with a disability needs the content. Do not rely on an archival exception for active course material.\nHow do I create a culture of accessibility and belonging in my course?\nSet a welcoming tone at the beginning of the course. State your commitment to an accessible learning experience and invite students to share barriers early.\nExplain that accessibility improves the course for everyone, and students should be able to report access problems without being seen as difficult. Model accessibility in your materials and in work students share with classmates—for example, descriptive links, captions for student-created video, and readable document structure.\nWhen a barrier appears, thank the student, provide a timely alternative, and fix the source material so the problem does not recur.\nHow do I raise awareness of digital accessibility in my department or college?\nPut accessibility on department and college meeting agendas regularly, not only near compliance deadlines.\nIdentify shared materials, blueprint courses, templates, common rubrics, and program-level documents that can be improved once and reused. Create a shared space for accessible materials, including open educational resources, syllabus templates, slide templates, and vetted captioned media.\nCelebrate practical progress such as courses checked, high-use PDFs replaced, videos captioned, or templates improved.\nBesides instructional materials, what else should faculty consider?\n- Web pages connected to courses, programs, centers, grants, and events.\n- Email announcements, newsletters, flyers, social media graphics, and recruitment materials.\n- Live and virtual events, including registration forms, slide decks, captioning, ASL interpreting when needed, recordings, and handouts.\n- Forms used for advising, field placements, surveys, applications, or student projects.\n- Third-party tools adopted for polling, collaboration, simulations, homework, and other course activities.\nWhat should I do when a student reports an accessibility barrier?\n- Respond quickly and acknowledge the issue.\n- Provide an accessible alternative as soon as practical.\n- Do not require the student to troubleshoot the course design problem; ask only for the information needed to understand the barrier.\n- Contact instructional technology, disability services, library, captioning, or accessibility staff based on the content type.\n- Update the source material and note the fix so the next course copy does not repeat the barrier.\nWhat can automated accessibility tools find, and what do they miss?\nTools can find many missing headings, missing alt text fields, poor link text, color contrast issues, table header problems, and some document issues.\nThey usually cannot determine whether alt text is meaningful, captions are accurate, PDF reading order makes sense, instructions are clear, or a learning activity has an accessible equivalent.\nUse tools for discovery and progress tracking but rely on human review for instructional quality.\n### Still deciding where to begin?\nStart with the 8-step faculty checklist, then use the campus support directory for complex content or local workflows.\n\n## Links on this page\n\n- 8-step faculty checklist (https://ati.calstate.edu/accessible-instructional-materials/8-steps-more-accessible-course)\n- campus support directory (https://ati.calstate.edu/accessible-instructional-materials/find-accessibility-support-your-campus)\n",
    w.raw_text_captured = date("2026-10-15")
MERGE (g)-[r:is_sourced_from]->(w)
  ON CREATE SET r.added_date = date("2026-10-15");

// ---------------------------------------------------------------- C. drives (strong matches only)
MATCH (g:Guideline {title: "CSU ATI Accessible Instructional Materials"})
MATCH (s:SuccessIndicator {composite_key: "4.3-ins"}) WHERE coalesce(s.removed, false) = false
MERGE (g)-[r:drives]->(s)
  ON CREATE SET r.added_date = date("2026-10-15")
SET r.provision = "8 steps to a more accessible course, step 7: Use Canvas pages over files when possible", r.quote = "Convert short instructions, weekly overviews, policies, and assignment prompts into Canvas pages instead of PDF attachments.", r.note = "The eight steps are documented guidelines for creating accessible course content in Canvas. Steps 7 and 8 name the Canvas Rich Content Editor and its Accessibility Checker.";

MATCH (g:Guideline {title: "CSU ATI Accessible Instructional Materials"})
MATCH (s:SuccessIndicator {composite_key: "7.5-ins"}) WHERE coalesce(s.removed, false) = false
MERGE (g)-[r:drives]->(s)
  ON CREATE SET r.added_date = date("2026-10-15")
SET r.provision = "Accessible Instructional Materials hub, Build a more accessible course", r.quote = "Use eight concrete practices for structure, images, links, media, readings, documents, Canvas pages, and accessibility checkers.", r.note = "The hub is the systemwide resource set for faculty creating accessible content. Each linked page gives practices, examples and a quick check.";

MATCH (g:Guideline {title: "CSU ATI Accessible Instructional Materials"})
MATCH (s:SuccessIndicator {composite_key: "6.8-ins"}) WHERE coalesce(s.removed, false) = false
MERGE (g)-[r:drives]->(s)
  ON CREATE SET r.added_date = date("2026-10-15")
SET r.provision = "Understand the standard and prioritize the work, How to prioritize", r.quote = "Start with high-impact items students need now: syllabus, assignments, assessments, weekly instructions, required readings, required videos, and current communications.", r.note = "The page sets a priority order for remediation. Its fix, replace, or rebuild decision then picks the remediation method for each item.";

MATCH (g:Guideline {title: "CSU ATI Accessible Instructional Materials"})
MATCH (s:SuccessIndicator {composite_key: "6.7-ins"}) WHERE coalesce(s.removed, false) = false
