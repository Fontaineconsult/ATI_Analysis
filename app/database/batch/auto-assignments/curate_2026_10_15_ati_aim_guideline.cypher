SET r.provision = "8 steps to a more accessible course, step 6: Create accessible documents before uploading", r.quote = "Export PDFs from accessible source documents when necessary; avoid printing to PDF because it can remove accessibility information.", r.note = "Step 6 covers creating Word, PowerPoint and PDF files. The tools page adds the CSU PDF remediation service for documents that need repair.";
