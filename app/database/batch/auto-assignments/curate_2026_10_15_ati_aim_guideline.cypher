SET r.provision = "Faculty FAQ, What can automated accessibility tools find, and what do they miss?", r.quote = "Use tools for discovery and progress tracking but rely on human review for instructional quality.", r.note = "The indicator asks for evaluation with automated tools and manual techniques. The FAQ splits the work the same way, and the tools page lists the course checkers.";

MATCH (g:Guideline {title: "CSU ATI Accessible Instructional Materials"})
