// Atrium Campus One Card_SSU_May2026.docx
// TAAP atrium-campus-one-card-ssu--seawolf-services-center--2026 at ssu, academic year 2025-2026. Generated 2026-10-07 by
// app/database/tools/taap_import from the signed form; decisions in
// app/database/tools/taap_import/decisions/. Re-running is a no-op except that
// the TAAP's own properties are re-set from the form.
// Requesting unit 'Seawolf Services Center' is inferred from the signers and prose, not stated on the form.

// ---- vendor
MERGE (v:Vendor {name: "Atrium Campus"})
ON CREATE SET v.unique_id = replace(randomUUID(), "-", "");

// ---- asset (create_asset twin: composite identifier, campus anchor, vendor)
MATCH (c:Campus {abbreviation: "ssu"})
MERGE (a:Asset {asset_identifier: "atrium-campus-one-card-ssu"})
ON CREATE SET a.unique_id = replace(randomUUID(), "-", ""), a.title = "Atrium Campus One Card", a.scope = "campus",
              a.asset_class = "third_party_service", a.version = "Atrium Connect"
MERGE (a)-[:asset_at_campus]->(c)
WITH a
MATCH (v:Vendor {name: "Atrium Campus"})
MERGE (a)-[:supplied_by]->(v);

// ---- requesting unit (create_org_unit twin: Department under the campus)
MATCH (c:Campus {abbreviation: "ssu"})
MERGE (u:OrgUnit {name: "Seawolf Services Center"})
ON CREATE SET u:Department, u.unique_id = replace(randomUUID(), "-", "")
MERGE (u)-[:operates_under_campus]->(c);

// ---- signers (add_person twin: active, not a committee member; campus only when new)
MATCH (c:Campus {abbreviation: "ssu"})
MERGE (p:Person {name: "Chris Hendry"})
ON CREATE SET p.unique_id = replace(randomUUID(), "-", ""), p.active = true, p.can_approve_yse = false,
              p.non_committee_member_active = true
WITH p, c WHERE NOT (p)-[:works_at_campus]->()
MERGE (p)-[:works_at_campus]->(c);
MATCH (c:Campus {abbreviation: "ssu"})
MERGE (p:Person {name: "Neil Markley"})
ON CREATE SET p.unique_id = replace(randomUUID(), "-", ""), p.active = true, p.can_approve_yse = false,
              p.non_committee_member_active = true
WITH p, c WHERE NOT (p)-[:works_at_campus]->()
MERGE (p)-[:works_at_campus]->(c);

// ---- signed copy (Document keyed by the PDF's SHA-256; verbatim text in raw_text)
MERGE (doc:Document {hash: "7bb7226cd4c645bf853afb0482186832385af33db31ec92ee6643af88144a8b0"})
ON CREATE SET doc.unique_id = replace(randomUUID(), "-", ""), doc.name = "Atrium Campus One Card_SSU_May2026 (signed).pdf",
              doc.file_path = "C:\\Users\\913678186\\Box\\SFBRN ATI\\Procurement\\TAAP\\Completed TAAPs\\Atrium Campus One Card_SSU_May2026 (signed).pdf",
              doc.description = "Signed Temporary Alternate Access Plan (CSU template 3.2 051225).",
              doc.raw_text = "       \n \n    Sonoma State University \n \nhttps://ati.calstate.edu/ati-priority-areas/procurement/temporary-alternate-access-planning \nhttps://access.sfsu.edu/ati/procurement/eeaap \nVersion 3.2 051225 \n \nContent is licensed under a Creative Commons Attribution 4.0 International license.       \n \nTemporary Alternative Access Plan (TAAP) \nFormerly, Equally Effective Alternative Access Plan (EEAAP). \nICT Product Information \nProduct Name: Atrium Campus One Card \n  \nVersion: Atrium Connect \nVendor Contact: N/A \nTemporary Alternate Access Plan Creation Date: 5/12/2026 \nReferenced Documentation \nUpload the referenced documents to the ATI Systemwide ACR Repository (SharePoint Login \nCredentials Required). Create a product folder for the ICT if one does not already exist. Once \nuploaded, generate links and place them below: \n \n• \nProduct Accessibility Conformance Report (ACR) \nlink, if applicable \n• \nVendor Accessibility Demonstration Results \nlink, if applicable \n• \nManual or Automated Testing Results: \nlink, if applicable \n• \nVendor Accessibility Roadmap: \nlink, if applicable \nKnown Accessibility Barriers \nDescribe the known accessibility barriers that affect core functionality.  \n-Some images and logos, both decorative and meaningful, have incorrect or incomplete \nalternative text.  \n- Some headings do not match their visual level or are incorrectly given the heading markup \nwhen they do not serve as headings.  \n- Table Elements are used for layout purposes but not marked as presentational.  \n-When users are timing out of their session and presented the option to extend their session, \nthey are automatically logged out after some time on the dashboard. \n- Non-interactive controls inappropriately receive keyboard focus on the login and virtual ID \npages.  \n- Image links on the virtual ID page have inappropriate names. \n- Some links are given accessible names that do not match the visual labels.  \n- Upon submitting the login form with errors, users are redirected to the login page without any \nerrors.  \n- The login page and its input fields lack persistent visual labels.  \n- The flip card feature on the virtual ID page is missing state information. \n\n \n \nhttps://ati.calstate.edu/ati-priority-areas/procurement/temporary-alternate-access-planning \nhttps://access.sfsu.edu/ati/procurement/eeaap \nVersion 3.2 051225 \n \nContent is licensed under a Creative Commons Attribution 4.0 International license.       \n \n- ARIA is used inappropriately on the sidenav, login, dashboard, account activity, and virtual ID \npages.  \n- The “How do I know my login credentials?” button is nested incorrectly with the tooltip content \non the login page.  \n- Common form controls lack a programmatic way to communicate purpose such as an \nautocomplete attribute on the login page.  \n- There is insufficient contrast on the virtual ID page \n- The “Need Help?” link is cut off when the page has a viewport width of 320 CSS pixels on the \nFooter.  \n- The “Virtual ID will refresh in “MM:SS”” content is a dynamically changing content area that \ndoes not indicate a live region on the virtual ID page.  \n \nAffected User Groups \nChoose all that apply. \n \n☒ Blindness \n☒ Low Vision \n☒ Deafness \n☒ Hard of Hearing \n☒ Limited Manual Dexterity \n☒ Cognitive Disability \n☐ Speech Disabilities \n☐ Photosensitivity \n☐ Limited Reach and Strength \n \nProposed Alternative \nPlease provide details on the proposed alternative solution. \n \nDescribe how the proposed alternative will address the barrier(s), describe the resources \nrequired or personnel, and name the responsible department.  \nThe purchasing department is placing a notice in the product and on the website where the \nproduct is discussed, guiding any users who face difficulties using the product to seek support \nby contacting the Seawolf Services Center via contact information provided on the product and \n\n \n \nhttps://ati.calstate.edu/ati-priority-areas/procurement/temporary-alternate-access-planning \nhttps://access.sfsu.edu/ati/procurement/eeaap \nVersion 3.2 051225 \n \nContent is licensed under a Creative Commons Attribution 4.0 International license.       \n \non the Seawolf Service Centers website. The Seawolf Service Center will provide support \nalongside Chris Hendry.  \n \nProduct Specific Accessibility Statement \nDraft a concise accessibility statement tailored specifically to this product (not your general \ncampus-wide accessibility statement) that includes: \n \n☒ Known barriers in the product interface. \n☒ Impacted disability groups. \n☐ Link or reference to this document. \n☒ Add a disclaimer: best effort was made, but unknown barriers may remain. \n☒ Provide contact for further accessibility assistance. \n \n(Post this statement wherever the product is available and in use.) \nThis product may pose a barrier to users with visual impairments, hearing impairments, limited \ndexterity, and cognitive disabilities. The barriers primarily lie on the login page and on the Virtual \nID page. The barriers to accessibility and the groups affected were derived from a Voluntary \nProduct Accessibility Template (VPAT) to the best of our ability, it is possible that other barriers \nto accessibility lie within the product, or that other user groups may be impacted in their ability \nto use the product. Should a user need any assistance accessing the product or any of the \nprocesses contained in the product they can contact wolfbucks@sonoma.edu \n \nCommunication and Distribution \nThe document must be easily referenced. Indicate which of the following actions have been \ntaken: \n \n☐ Posted the Accessibility Statement in course syllabi (if applicable). \n \n☒ Posted the Accessibility Statement where the product is accessed. \n \n☒ Provided copies of this document to Requesting Department/Area. \n☐ Provided copies of this document to Disability Services Office. \n☐ Provided copies of this document to Human Resources (ADA Coordinators). \n\n \n \nhttps://ati.calstate.edu/ati-priority-areas/procurement/temporary-alternate-access-planning \nhttps://access.sfsu.edu/ati/procurement/eeaap \nVersion 3.2 051225 \n \nContent is licensed under a Creative Commons Attribution 4.0 International license.       \n \n☒ Provided copies of this document to IT Help Desk. \n☐ Saved the document in the ATI Systemwide ACR Repository (SharePoint Login \nCredentials Required) \n☐ Other: [Specify] \n \n \nReview the proposed solution to determine if it meets the following legal requirements to be \nequally effective. A non-equal alternative or individualized accommodation will be required if it \ndoes not. \n \nRequirements Checklist \nTo qualify as an Equally Effective Alternative, the plan must meet ALL the following: \n• ☒ Allows access to the same information, engagement, and services. \n• ☒ Offers the same availability as the primary solution.  \n• ☐ Can be accessed independently without additional assistance. \n• ☒ Does not result in disparate burden or impact on the user. \n• ☒ Has substantially equivalent ease of use. \n• ☐ Protects the privacy of the individuals affected. \n• ☐ Saved the document in the ATI Systemwide ACR Repository (SharePoint Login \nCredentials Required) \n• ☐ Other: [Specify] \nProcess Outcome \nBased on the assessment above, the outcome of the Temporary Alternate Access Plan is: \n \n• ☐Meets all six legal requirements: Equally Effective. The proposed solution fully \nmeets all legal requirements for equally effective access, presenting minimal risk to the \ninstitution. In general, no individual accommodations are expected to be necessary. \nNon-conforming minimal impact on access. \n \n• ☒ Meets some (1-5) legal requirements: Partially Equally Effective. While the solution \npartially addresses accessibility, it may still require supplemental assistance for users. \nThis carries a moderate risk to the institution, and staff should be prepared to provide \nadditional support for affected individuals. \n\n \n \nhttps://ati.calstate.edu/ati-priority-areas/procurement/temporary-alternate-access-planning \nhttps://access.sfsu.edu/ati/procurement/eeaap \nVersion 3.2 051225 \n \nContent is licensed under a Creative Commons Attribution 4.0 International license.       \n \n \n• ☐ Unable to provide alternative means of access: Need for Individualized \nAccommodation. If no effective alternative solution is available, individualized \naccommodations must be provided for each affected user. This requires alerting the \ndisability services and human resources offices. The department responsible for \nobtaining the product may face additional costs to cover individualized \naccommodations, and this scenario presents a high risk to the institution.  \nInstitutional Risk \n• ☐ HIGH: No alternative access provided (Supports 0 criteria) \n• ☒ MODERATE: Non-Equal Alternative Access (Supports 1-5 criteria) \n• ☐ LOW: Equally Effective Alternative Access (Supports all 6 criteria) \nAccommodation Requirements \n• ☐ HIGH: Accommodations required for all users (Supports 0 criteria) \n \n• ☒ MODERATE:  Accommodations required for some users (Supports 1-5 criteria) \n• ☐ LOW: Accommodations required for minimal number of users (Supports all 6 \ncriteria) \n \nAdministrative Approval \nBy signing below, each approver confirms that they have reviewed the proposed temporary \nalternative means of access, evaluated the associated institutional risks and accommodation \nrequirements, and determined that this plan serves as an acceptable interim solution for \nmeeting applicable compliance and legal obligations. \n \nRole \nName \nSignature \nDate \nDepartment Chair/Manager \nChris Hendry  \n \n \nDean/Division Vice President \nNeil Markley \n \n \n \n \nNext Review \nThe document should be reviewed and updated annually or when renewing the ICT, as TAAPs \nare temporary solutions until the vendor resolves accessibility issues. \nReview of this document should occur on or before [insert date] \n05/19/2026\nNeil (May 19, 2026 15:06:06 PDT)\n05/19/2026\n\n \n \nhttps://ati.calstate.edu/ati-priority-areas/procurement/temporary-alternate-access-planning \nhttps://access.sfsu.edu/ati/procurement/eeaap \nVersion 3.2 051225 \n \nContent is licensed under a Creative Commons Attribution 4.0 International license.       \n \nIn the event of Vendor Non-Compliance \nTAAPs are intended to be temporary and are only valid when regularly reviewed to confirm that \nthe vendor is actively working to remediate their ICT accessibility barriers.  \n \nIf this document is under review and there is no measurable progress from the vendor, its \ncontinued validity may be questioned. Should there be no improvement at the time of the annual \nreview, a formal memo must be prepared for the requesting department and signed by the \ninstitution’s highest executive leadership. \n \nThis memo should state that the vendor has failed to meet its commitment to address the \nknown accessibility barriers in its product. It should also explain why an alternative solution is \nnot being pursued at this time.  \n \nA copy of this memo may be shared with the vendor.  \n \nThis process should be repeated annually for as long as the institution continues to accept the \nassociated high risk. \nMiscellaneous Notes \n \nAfter I (Sara M.) met with Chris Hendry and Neil Markley on 5/19/2026, the accommodation of \nusers seeking assistance from the Seawolf Service Center was agreed upon, they received \nconfirmation that the Seawolf Service Center is willing to provide said support and the notice \nwas posted in the appropriate locations.  \n \n \nNotice to all Parties \nThe Temporary Alternate Access Plan should only serve as an interim measure while the \nvendors address the underlying barriers to full accessibility. As of April 24, 2026, Title II of the \nADA requires all ICT (Information and Communication Technology) to be fully accessible. In \nmost circumstances, Title II §35.205 also applies. \nWhile we may not yet meet every technical standard, we will use TAAPs to comply with §35.205, \nwhich deems that a public entity not in full compliance with §35.200(b) is still considered \ncompliant if the noncompliance has minimal impact on access and does not prevent individuals \nwith disabilities from: \n• \nAccessing the same information as individuals without disabilities; \n• \nEngaging in the same interactions as individuals without disabilities; \n• \nConducting the same transactions as individuals without disabilities; and \n\n \n \nhttps://ati.calstate.edu/ati-priority-areas/procurement/temporary-alternate-access-planning \nhttps://access.sfsu.edu/ati/procurement/eeaap \nVersion 3.2 051225 \n \nContent is licensed under a Creative Commons Attribution 4.0 International license.       \n \n• \nOtherwise participating in or benefiting from the same services, programs, and activities \nas individuals without disabilities. \nOur goal is 100% compliance, and we will rely on TAAPs only until these barriers are fully \nresolved. \nLegal Framework \n• \nSection 504 of the Rehabilitation Act of 1973 and Section 508 of the Rehabilitation Act \nof 1973 \n• \nAmericans with Disabilities Act Title II Regulations \n• \nCalifornia Government Code 11135 and California Government Code 7405\n\n \n \nhttps://ati.calstate.edu/ati-priority-areas/procurement/temporary-alternate-access-planning \nhttps://access.sfsu.edu/ati/procurement/eeaap \nVersion 3.2 051225 \n \nContent is licensed under a Creative Commons Attribution 4.0 International license.       \n \n \n", doc.raw_text_captured = date("2026-10-07"),
              doc.include_in_report = false, doc.depreciated = false;

// ---- the plan (create_taap twin: identifier, required edges, form fields)
MATCH (a:Asset {asset_identifier: "atrium-campus-one-card-ssu"})
MATCH (c:Campus {abbreviation: "ssu"})
MATCH (u:OrgUnit {name: "Seawolf Services Center"})
MERGE (t:TAAP {taap_identifier: "atrium-campus-one-card-ssu--seawolf-services-center--2026"})
ON CREATE SET t.unique_id = replace(randomUUID(), "-", "")
SET t.title = "Atrium Campus One Card",
    t.template_version = "3.2 051225",
    t.creation_date = date("2026-05-12"),
    t.vendor_contact = null,
    t.known_barriers = "-Some images and logos, both decorative and meaningful, have incorrect or incomplete alternative text.\n- Some headings do not match their visual level or are incorrectly given the heading markup when they do not serve as headings.\n- Table Elements are used for layout purposes but not marked as presentational.\n-When users are timing out of their session and presented the option to extend their session, they are automatically logged out after some time on the dashboard.\n- Non-interactive controls inappropriately receive keyboard focus on the login and virtual ID pages.\n- Image links on the virtual ID page have inappropriate names.\n- Some links are given accessible names that do not match the visual labels.\n- Upon submitting the login form with errors, users are redirected to the login page without any errors.\n- The login page and its input fields lack persistent visual labels.\n- The flip card feature on the virtual ID page is missing state information.\n- ARIA is used inappropriately on the sidenav, login, dashboard, account activity, and virtual ID pages.\n- The “How do I know my login credentials?” button is nested incorrectly with the tooltip content on the login page.\n- Common form controls lack a programmatic way to communicate purpose such as an autocomplete attribute on the login page.\n- There is insufficient contrast on the virtual ID page\n- The “Need Help?” link is cut off when the page has a viewport width of 320 CSS pixels on the Footer.\n- The “Virtual ID will refresh in “MM:SS”” content is a dynamically changing content area that does not indicate a live region on the virtual ID page.",
    t.affected_user_groups = ["blindness", "low_vision", "deafness", "hard_of_hearing", "limited_manual_dexterity", "cognitive_disability"],
    t.proposed_alternative = "The purchasing department is placing a notice in the product and on the website where the product is discussed, guiding any users who face difficulties using the product to seek support by contacting the Seawolf Services Center via contact information provided on the product and on the Seawolf Service Centers website. The Seawolf Service Center will provide support alongside Chris Hendry.",
    t.accessibility_statement = "This product may pose a barrier to users with visual impairments, hearing impairments, limited dexterity, and cognitive disabilities. The barriers primarily lie on the login page and on the Virtual ID page. The barriers to accessibility and the groups affected were derived from a Voluntary Product Accessibility Template (VPAT) to the best of our ability, it is possible that other barriers to accessibility lie within the product, or that other user groups may be impacted in their ability to use the product. Should a user need any assistance accessing the product or any of the processes contained in the product they can contact wolfbucks@sonoma.edu",
    t.statement_elements = ["known_barriers", "impacted_groups", "disclaimer", "assistance_contact"],
    t.distribution_actions = ["point_of_access", "requesting_department", "it_help_desk"],
    t.requirements_met = ["same_information", "same_availability", "no_disparate_burden", "equivalent_ease_of_use"],
    t.outcome = "non_equal_alternative",
    t.institutional_risk = "moderate",
    t.accommodation_requirement = "moderate",
    t.effective_date = null,
    t.review_due = null,
    t.misc_notes = "After I (Sara M.) met with Chris Hendry and Neil Markley on 5/19/2026, the accommodation of users seeking assistance from the Seawolf Service Center was agreed upon, they received confirmation that the Seawolf Service Center is willing to provide said support and the notice was posted in the appropriate locations.",
    t.taap_status = "signed",
    t.active = true
MERGE (t)-[:covers_asset]->(a)
MERGE (t)-[:taap_at_campus]->(c)
MERGE (t)-[:requested_by]->(u);

MATCH (t:TAAP {taap_identifier: "atrium-campus-one-card-ssu--seawolf-services-center--2026"}), (ay:AcademicYear {name: "2025-2026"})
MERGE (t)-[:taap_in_year]->(ay);
MATCH (t:TAAP {taap_identifier: "atrium-campus-one-card-ssu--seawolf-services-center--2026"}), (u:OrgUnit {name: "Seawolf Services Center"})
MERGE (t)-[:alternative_provided_by]->(u);
MATCH (t:TAAP {taap_identifier: "atrium-campus-one-card-ssu--seawolf-services-center--2026"}), (p:Person {name: "Sara Marquez"})
MERGE (t)-[:prepared_by]->(p);
MATCH (t:TAAP {taap_identifier: "atrium-campus-one-card-ssu--seawolf-services-center--2026"}), (p:Person {name: "Chris Hendry"})
MERGE (t)-[:owned_by]->(p);
MATCH (t:TAAP {taap_identifier: "atrium-campus-one-card-ssu--seawolf-services-center--2026"}), (p:Person {name: "Chris Hendry"})
MERGE (t)-[r:signed_by]->(p)
SET r.role = "department_head", r.signed_date = null;
MATCH (t:TAAP {taap_identifier: "atrium-campus-one-card-ssu--seawolf-services-center--2026"}), (p:Person {name: "Neil Markley"})
MERGE (t)-[r:signed_by]->(p)
SET r.role = "division_executive", r.signed_date = null;
MATCH (t:TAAP {taap_identifier: "atrium-campus-one-card-ssu--seawolf-services-center--2026"}), (doc:Document {hash: "7bb7226cd4c645bf853afb0482186832385af33db31ec92ee6643af88144a8b0"})
MERGE (t)-[:signed_copy]->(doc);

