// =====================================================================================
// Warning level grounding: sources behind the review matrix's warning level and a new
// principle. Prepared 2026-10-20 for Daniel Fontaine. Research memo:
// app/database/ontology/impact-matrix/warning-level-research.md
// GENERATED by scratch build_warning_batch.py, which verified every quote,
// whitespace-normalized, against the stored text of the node it cites or the text
// captured today for the new nodes. Re-run the builder rather than editing quotes.
//
// SECTIONS
//   1. Eight Webpage nodes for pages read today. raw_text is written separately through
//      neo4j-cli with raw_text_captured, never in a batch file. Minnesota's page is
//      bot-blocked and gets no text.
//   2. Twelve typed source nodes: nine IntellectualSource and three Guideline. Out-of-state
//      rules (Texas DIR) are IntellectualSource: Directive and Guideline are reserved for
//      what binds or guides the CSU.
//      HTML sources link to their Webpage with is_sourced_from. PDF sources (NIST, SEC-11,
//      Orange Book, CSUB deck) hold their own raw_text, as the TAAP template does.
//      The Section508.gov risk management page joins the existing Directive
//      "Section508.gov Guidance on Accessibility in Procurement".
//   3. One new Principle, residual-risk-stated-and-owned.
//   4. 24 derives_from groundings. MERGE with ON CREATE SET, so no existing
//      grounding is overwritten. None of these pairs existed on 2026-10-20.
//
// DEPENDS ON: nothing unexecuted. The 10/16 principles batch is still pending and this
// file does not reference its principles.
// NOT DONE: shapes edges for the new principle. Separate pass.
//
// VALIDATE FIRST
//   python -m app.database.cypher_runner.run_file app/database/batch/auto-assignments/curate_2026_10_20_warning_level_grounding.cypher
//   python -m app.database.cypher_runner.run_file app/database/batch/auto-assignments/curate_2026_10_20_warning_level_grounding.cypher --execute
// =====================================================================================

// --- 1. Webpages ---------------------------------------------------------------------------
MERGE (w:Webpage {url: "https://www.section508.gov/manage/governance/ict-accessibility-and-risk-management/"})
ON CREATE SET w.unique_id = replace(randomUUID(), "-", ""),
              w.name = "ICT Accessibility and Risk Management",
              w.description = "Section508.gov guidance that applies enterprise risk management to ICT accessibility: a likelihood by consequence matrix with six ratings, each defined by the attention it requires, a six-step process, and four risk responses, with acceptance defined as acknowledging the risk within tolerance and documenting the rationale.",
              w.include_in_report = false;

MERGE (w:Webpage {url: "https://www.washington.edu/accesstech/policy-resources/procurement/digital-product-accessibility-reviews/"})
ON CREATE SET w.unique_id = replace(randomUUID(), "-", ""),
              w.name = "UW Digital Product Accessibility Reviews",
              w.description = "University of Washington procedure that assigns each product a risk level and score with notes, routes medium and high risk to ACR review and testing, and sends failed products to an exemption panel that sets provisional requirements and an expiration date.",
              w.include_in_report = false;

MERGE (w:Webpage {url: "https://accessibility.arizona.edu/procurement/accessible-procurement-process"})
ON CREATE SET w.unique_id = replace(randomUUID(), "-", ""),
              w.name = "UA Accessible Procurement Process",
              w.description = "University of Arizona procurement procedure. The review returns a risk level, every exception documents business justification, alternatives, who is affected and how, a mitigation plan, a remediation timeline and a review date, and the risk level decides who approves.",
              w.include_in_report = false;

MERGE (w:Webpage {url: "https://btaa.org/technology/itaccessibility/prioritization-guide"})
ON CREATE SET w.unique_id = replace(randomUUID(), "-", ""),
              w.name = "BTAA ITAG Accessibility Prioritization Guide",
              w.description = "Big Ten Academic Alliance tool that rates a project or procurement as lower, medium or higher priority from audience, required use, status and vendor options, and pairs the upper tiers with an equally effective alternate access plan and a remediation roadmap.",
              w.include_in_report = false;

MERGE (w:Webpage {url: "https://www.csuci.edu/office-departments/ati/sla/impact-assessment-scoring.html"})
ON CREATE SET w.unique_id = replace(randomUUID(), "-", ""),
              w.name = "CSUCI IT Procurement Impact Assessment Scoring",
              w.description = "CSU Channel Islands page that reads the impact assessment score: 34 or below is low to moderate risk and impact, 35 or above is high risk and high impact and requires VPAT review, accessibility testing and an EEAAP.",
              w.include_in_report = false;

MERGE (w:Webpage {url: "https://dir.texas.gov/electronic-information-resources-eir-accessibility/eir-accessibility-roles-and-responsibilities/eir"})
ON CREATE SET w.unique_id = replace(randomUUID(), "-", ""),
              w.name = "Texas DIR EIR Accessibility Requirements, Exceptions, and Exemptions",
              w.description = "Texas Department of Information Resources page on the state EIR accessibility statute and rules, the exception the head of an agency or institution may grant for significant difficulty or expense, the alternate method of access that follows an exception, and the absence of statewide exemptions.",
              w.include_in_report = false;

MERGE (w:Webpage {url: "https://www.nature.com/articles/nclimate2194"})
ON CREATE SET w.unique_id = replace(randomUUID(), "-", ""),
              w.name = "The interpretation of IPCC probabilistic statements around the world",
              w.description = "Nature Climate Change article page, Budescu, Por, Broomell and Smithson (2014). The abstract reports a 24-country study in which readers pulled verbal probability terms toward 50 percent, and numeric ranges beside the words improved the match.",
              w.include_in_report = false;

MERGE (w:Webpage {url: "https://mn.gov/mnit/media/blog/index.jsp?id=38-669671"})
ON CREATE SET w.unique_id = replace(randomUUID(), "-", ""),
              w.name = "Updating Minnesota's Accessibility Exceptions Process, Part 2",
              w.description = "Minnesota IT Services blog post describing the state's accessibility exceptions workflow: a risk matrix assigns a level from agency data, the exception records that the agency acknowledges barriers, accepts the risk and plans mitigation, and a dashboard shows every exception on file. The page is bot-blocked, so no text is stored.",
              w.include_in_report = false;

// --- 2. Source nodes -----------------------------------------------------------------------
MERGE (i:IntellectualSource {name: "University of Washington, Digital Product Accessibility Reviews"})
ON CREATE SET i.unique_id = replace(randomUUID(), "-", "")
SET i.publisher = "University of Washington, Civil Rights Compliance and UW-IT Accessible Technology Services",
    i.url = "https://www.washington.edu/accesstech/policy-resources/procurement/digital-product-accessibility-reviews/",
    i.description_short = "A university review procedure that sends the purchaser a risk level, a risk score and the reasons, and routes products by that level to ACR review, testing, provisional approval or exemption.",
    i.description_full = "The product owner completes a review form about how the product is used, who has access and how many people use it. Civil Rights Compliance staff return a scope assessment, a risk level of low, medium or high, and a risk score with notes that say why the product received its level. Low-risk products go straight to provisional approval. Medium and high-risk products go to an ACR review and then to baseline or extended testing. A product that fails testing goes to an exemption panel, which weighs the risk level, the severity of the issues, statutory obligations, the absence of another product and the developer's path to remediation, and which sets provisional requirements and an expiration date. Products the panel does not qualify go to the CIO.";

MATCH (i:IntellectualSource {name: "University of Washington, Digital Product Accessibility Reviews"})
MATCH (w:Webpage {url: "https://www.washington.edu/accesstech/policy-resources/procurement/digital-product-accessibility-reviews/"})
MERGE (i)-[:is_sourced_from]->(w);

MERGE (i:IntellectualSource {name: "University of Arizona, Accessible Procurement Process"})
ON CREATE SET i.unique_id = replace(randomUUID(), "-", "")
SET i.publisher = "University of Arizona Digital Accessibility",
    i.url = "https://accessibility.arizona.edu/procurement/accessible-procurement-process",
    i.description_short = "A university procurement procedure in which the risk level decides who approves an exception, and every exception records who is affected and how, the mitigation, the remediation timeline and the review date.",
    i.description_full = "The review returns a risk level of low, medium or high. An exception may be considered when no accessible alternative exists, the product serves a critical function with limited users, the vendor has a committed roadmap, or effective workarounds exist. To approve one, the unit documents the business justification, the alternatives considered, a risk assessment of who is affected and how, a mitigation plan for how users with disabilities will be accommodated, the vendor's remediation timeline and a review date. The Digital Accessibility Director approves low-risk exceptions, unit leadership and the Director approve medium-risk ones, and high-risk exceptions need the Steering Committee.";

MATCH (i:IntellectualSource {name: "University of Arizona, Accessible Procurement Process"})
MATCH (w:Webpage {url: "https://accessibility.arizona.edu/procurement/accessible-procurement-process"})
MERGE (i)-[:is_sourced_from]->(w);

MERGE (i:IntellectualSource {name: "Big Ten Academic Alliance, ITAG Accessibility Prioritization Guide"})
ON CREATE SET i.unique_id = replace(randomUUID(), "-", "")
SET i.publisher = "Big Ten Academic Alliance, IT Accessibility Group",
    i.url = "https://btaa.org/technology/itaccessibility/prioritization-guide",
    i.description_short = "A consortium tool that rates a project or procurement as lower, medium or higher priority from audience size, required use and vendor options, and pairs the upper tiers with an alternate access plan and a remediation roadmap.",
    i.description_full = "The guide, adapted from a University of California tool, asks about audience (roughly 1 to 50, 50 to 1,000, or 1,000 or more people or the public), whether use is required, project status, implementation timeframe, vendor options, PDFs and accommodation requests. Lower-priority results still carry some institutional risk. Medium results represent a serious risk footprint, and the guide says a plan for equally effective alternate access and a remediation roadmap and timeline may be necessary. Higher results represent a severe or critical risk footprint and call for formal accessibility requirements, evaluation, an alternate access plan and a correction timeline. Results are recorded and reassessed annually or when conditions change.";

MATCH (i:IntellectualSource {name: "Big Ten Academic Alliance, ITAG Accessibility Prioritization Guide"})
MATCH (w:Webpage {url: "https://btaa.org/technology/itaccessibility/prioritization-guide"})
MERGE (i)-[:is_sourced_from]->(w);

MERGE (i:IntellectualSource {name: "Minnesota IT Services, Updating Minnesota's Accessibility Exceptions Process, Part 2 (2025)"})
ON CREATE SET i.unique_id = replace(randomUUID(), "-", "")
SET i.publisher = "Minnesota IT Services, Office of Accessibility",
    i.url = "https://mn.gov/mnit/media/blog/index.jsp?id=38-669671",
    i.description_short = "A state accessibility office describes its exceptions workflow: a risk matrix assigns a level from agency data, the exception records acknowledgement of barriers and acceptance of the risk, and a dashboard shows every exception on file.",
    i.description_full = "Minnesota IT Services rebuilt its accessibility exceptions process on SharePoint and PowerApps. An agency files an exception for technology with known barriers or without credible accessibility documentation. A risk matrix analyzes the agency's answers and assigns a risk level, so that an expensive, hard-to-replace application used by the public rates above a specialized tool used by three lab technicians. The exception has the agency acknowledge that the technology may present barriers, accept the associated risks and plan mitigation. The level helps the agency decide whether to proceed and, if it proceeds, highlights the need for additional steps to prevent negative user experiences. Agencies see a dashboard of all their filed exceptions. Read 2026-10-20 from a fetched summary, because the page refuses automated requests, so no quotation is stored.";

MATCH (i:IntellectualSource {name: "Minnesota IT Services, Updating Minnesota's Accessibility Exceptions Process, Part 2 (2025)"})
MATCH (w:Webpage {url: "https://mn.gov/mnit/media/blog/index.jsp?id=38-669671"})
MERGE (i)-[:is_sourced_from]->(w);

MERGE (i:IntellectualSource {name: "Budescu, Por, Broomell and Smithson, The interpretation of IPCC probabilistic statements around the world (2014)"})
ON CREATE SET i.unique_id = replace(randomUUID(), "-", "")
SET i.author = "David V. Budescu; Han-Hui Por; Stephen B. Broomell; Michael Smithson",
    i.publisher = "Nature Climate Change",
    i.citation = "Budescu, D. V., Por, H.-H., Broomell, S. B. & Smithson, M. The interpretation of IPCC probabilistic statements around the world. Nature Climate Change 4, 508-512 (2014).",
    i.url = "https://www.nature.com/articles/nclimate2194",
    i.description_short = "A 24-country study showing that readers pull verbal probability terms toward 50 percent, and that printing numeric ranges beside the words improves the match and separates the terms.",
    i.description_full = "The IPCC conveys uncertainty with verbal terms such as \"unlikely\". Across 25 samples in 24 countries and 17 languages, laypeople interpreted those statements as probabilities closer to 50 percent than the authors intended, with large variation between people. Presenting the numeric range with the verbal term every time increased correspondence with the IPCC guidelines and differentiated the terms, and the pattern held across languages. Only the abstract is open; the stored page text is what the article page shows without a subscription.";

MATCH (i:IntellectualSource {name: "Budescu, Por, Broomell and Smithson, The interpretation of IPCC probabilistic statements around the world (2014)"})
MATCH (w:Webpage {url: "https://www.nature.com/articles/nclimate2194"})
MERGE (i)-[:is_sourced_from]->(w);

MERGE (i:IntellectualSource {name: "NIST SP 800-37 Rev. 2, Risk Management Framework for Information Systems and Organizations (2018)"})
ON CREATE SET i.unique_id = replace(randomUUID(), "-", "")
SET i.author = "Joint Task Force",
    i.publisher = "National Institute of Standards and Technology",
    i.citation = "NIST Special Publication 800-37, Revision 2, Risk Management Framework for Information Systems and Organizations: A System Life Cycle Approach for Security and Privacy (December 2018). https://doi.org/10.6028/NIST.SP.800-37r2",
    i.url = "https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-37r2.pdf",
    i.description_short = "The federal risk management framework. Authorization is an explicit, signed acceptance of residual risk by the authorizing official, and that one act cannot be delegated.",
    i.description_full = "The framework runs through prepare, categorize, select, implement, assess, authorize and monitor. In the authorize step, Task R-4, the authorizing official determines whether the risk from operating the system is acceptable and issues or denies an authorization. The discussion states that the explicit acceptance of risk is the responsibility of the authorizing official and cannot be delegated. A designated representative may carry out every other activity, but not the authorization decision and the signing of the decision document. The decision rests on the security and privacy posture reported in the authorization package, and the framework treats authorization as a judgment that residual risk is acceptable, never as a claim that risk is gone. Text extracted from the PDF.";

MERGE (i:IntellectualSource {name: "Washington State OCIO, SEC-11 Risk Management Policy (2023)"})
ON CREATE SET i.unique_id = replace(randomUUID(), "-", "")
SET i.publisher = "Washington Technology Solutions, Office of the Chief Information Officer",
    i.url = "https://watech.wa.gov/sites/default/files/2024-09/SEC-11%20Risk%20Management%20Policy.pdf",
    i.description_short = "A state policy that has agencies define risk appetite and tolerance, mitigate or accept identified risks before a system operates, and have an authorized officer accept residual risk, with responsibility that cannot be delegated.",
    i.description_full = "Adopted by the state CIO in February 2023. Agencies define their risk appetite and tolerance levels, and either mitigate or accept identified risks before systems go into operation. Residual risk, the calculated risk remaining after the treatment plan, must be documented, accepted and monitored, and accepted by an agency officer authorized to make risk treatment decisions. Approval authority may be delegated in writing, but ultimate responsibility for risk acceptance cannot be. Risk owners sign off that they accept the residual risks identified in the assessment. Text extracted from the PDF.";

MERGE (i:IntellectualSource {name: "HM Treasury, The Orange Book: Management of Risk, Principles and Concepts (2004)"})
ON CREATE SET i.unique_id = replace(randomUUID(), "-", "")
SET i.publisher = "HM Treasury, United Kingdom",
    i.citation = "HM Treasury, The Orange Book: Management of Risk - Principles and Concepts (October 2004).",
    i.url = "https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/191513/The_Orange_Book.pdf",
    i.description_short = "The UK government's risk management guide. What matters about an assessed risk is whether it is tolerable and how far the exposure sits from tolerability, not its absolute value, and residual risk is compared against a tolerable impact and frequency.",
    i.description_full = "The 2004 Orange Book defines risk appetite as the amount of risk judged tolerable and justifiable, and residual risk as the exposure left after internal control. Section 4.4 states that it is not the absolute value of an assessed risk that matters but whether the risk is regarded as tolerable, or how far the exposure is from tolerability. Section 4.5 says that for a specific risk an acceptable level of exposure can be defined as a tolerable impact and a tolerable frequency, and that residual risk is compared against that to decide whether further action is required. The book also describes escalation: what is a high risk at one level of management is a lower risk at the next, which lets risks cascade upward. A 2023 edition supersedes it for UK departments and keeps the appetite and tolerance concepts. Text extracted from the PDF.";

MERGE (i:IntellectualSource {name: "Texas DIR, EIR Accessibility Requirements, Exceptions, and Exemptions"})
ON CREATE SET i.unique_id = replace(randomUUID(), "-", "")
SET i.publisher = "Texas Department of Information Resources",
    i.url = "https://dir.texas.gov/electronic-information-resources-eir-accessibility/eir-accessibility-roles-and-responsibilities/eir",
    i.description_short = "The accessibility rules of another state, read for their design, read for their design. The head of the agency or institution grants an exception for significant difficulty or expense, and an alternate method of access follows the exception. There are no statewide exemptions.",
    i.description_full = "Texas state rules for electronic and information resources accessibility, under Texas Government Code 2054.457 and 1 TAC 206 and 213. Agencies and institutions of higher education decide whether a provision imposes significant difficulty or expense, obtain an exception from the head of the agency or institution if it does, and provide an alternate method of access to people with disabilities once an exception is determined. There are no statewide exemptions. The rules bind Texas, not the CSU, so the graph holds them as an intellectual source rather than a directive.";

MATCH (i:IntellectualSource {name: "Texas DIR, EIR Accessibility Requirements, Exceptions, and Exemptions"})
MATCH (w:Webpage {url: "https://dir.texas.gov/electronic-information-resources-eir-accessibility/eir-accessibility-roles-and-responsibilities/eir"})
MERGE (i)-[:is_sourced_from]->(w);

MERGE (g:Guideline {title: "CSU Channel Islands, IT Procurement Impact Assessment Scoring"})
ON CREATE SET g.unique_id = replace(randomUUID(), "-", "")
SET g.description = "A CSU campus reads its impact assessment numerically. A score of 34 or below is a low to moderate risk and impact procurement, and ITS verifies the VPAT. A score of 35 or above is a high-risk, high-impact procurement, and ITS reviews the VPAT, tests the product under the ATI Testing SLA, and the requester submits an Equally Effective Alternative Access Plan.";

MATCH (g:Guideline {title: "CSU Channel Islands, IT Procurement Impact Assessment Scoring"})
MATCH (w:Webpage {url: "https://www.csuci.edu/office-departments/ati/sla/impact-assessment-scoring.html"})
MERGE (g)-[:is_sourced_from]->(w);

MERGE (g:Guideline {title: "SFSU, Determining Impact of a Technology Acquisition"})
ON CREATE SET g.unique_id = replace(randomUUID(), "-", "")
SET g.description = "San Francisco State's adaptation of the CSU ATI Prioritization Framework. A high impact product affects a critical program, reaches a large audience or the public, creates high accommodation costs and significant legal exposure, denies access to a program for people with disabilities, creates frequently recurring barriers, and has a strong likelihood of impact. Medium impact limits access, with moderate audience, costs and exposure. Low impact does not limit access. High impact products undergo a thorough evaluation, and medium impact products at the discretion of the DPRC.";

MATCH (g:Guideline {title: "SFSU, Determining Impact of a Technology Acquisition"})
MATCH (w:Webpage {url: "https://access.sfsu.edu/ati/procurement/impact"})
MERGE (g)-[:is_sourced_from]->(w);

MERGE (g:Guideline {title: "CSU Bakersfield, Procurement of Accessible ICT training (2021)"})
ON CREATE SET g.unique_id = replace(randomUUID(), "-", "")
SET g.description = "A CSU Bakersfield training deck on accessible ICT procurement. Its Accessibility Risk Assessment slide lays the CSU framework out on two axes. Impact: denies access to a program or service, impacts a critical program, creates high accommodation costs, creates significant legal exposure, no available workarounds, against limits access and workarounds for some functions, against does not limit access and workarounds for all functions. Probability: a large audience or the public, frequently recurring barriers and a strong likelihood of impact, down to a small audience, no recurring barriers and a low likelihood. The deck says CSUB allows no exemptions and requires an EEAAP for any product that is not fully accessible. Text extracted from the PDF.";

MATCH (d:Directive {unique_id: "34a1e0763aaa4b2c80dfb8cc672fbb36"})
MATCH (w:Webpage {url: "https://www.section508.gov/manage/governance/ict-accessibility-and-risk-management/"})
MERGE (d)-[:is_sourced_from]->(w);

// --- 3. New principle ----------------------------------------------------------------------
MERGE (p:Principle {handle: "principle:residual-risk-stated-and-owned"})
ON CREATE SET p.unique_id = replace(randomUUID(), "-", "")
SET p.name = "Residual risk is stated by consequence and owned by a named officer",
    p.description_short = "When the institution proceeds with technology that still has barriers, the record states who cannot do what without staff support, what the department carries, and which officer accepted that. A graded label summarizes that statement and never replaces it.",
    p.description_full = "A plan for alternate access treats a risk without removing it. Public risk frameworks call what remains residual risk, and they agree on how it is handled. NIST makes the acceptance of residual risk an explicit, signed act by the authorizing official, and that one act cannot be delegated. Washington State applies the same rule to its agencies: an authorized officer accepts residual risk, approval may be delegated in writing, responsibility may not. The federal ICT accessibility guidance defines acceptance as acknowledging the risk within a defined tolerance and documenting the rationale. The CSU TAAP template already names the officers: each signer confirms they evaluated the institutional risks and accommodation requirements and found the plan an acceptable interim solution.\n\nWhat the record states is consequence, not inputs. The CSU's own impact framework names the consequences that count: access denied or limited, a critical program affected, accommodation cost on the department, legal exposure, and no workaround. A residual risk statement therefore says which essential functions, for which people, rest on staff support rather than on the product, how many people that covers, what the department carries until the vendor remediates, and which legal duty continues. HM Treasury's guidance adds the measure: what matters about an assessed risk is not its absolute value but how far the exposure sits from what the institution has decided to tolerate.\n\nA graded label is useful only with a fixed meaning. The federal guidance defines each of its six ratings by the attention it requires. Peer universities use the level to decide who signs and when the exception expires, and they send the score and the reasons with the level. Research on verbal probability terms shows readers pull a word toward the middle of the scale unless the number appears beside it, and risk matrices compress very different cases into one bin. So the label carries its components and a sentence that says what it means and what the signer does.\n\nThis principle governs the warning level in the review matrix. The level derives from pressure, the audience and barrier reach the plan must carry, and the gap, the requirements the plan leaves uncovered. It never lowers the TAAP standard, which is the tolerance line. It states the consequence by severity, names the audience, maps to the TAAP signers' acknowledgement, and sets the review at the first roadmap milestone. Its companion is the principle that alternative access is time-bound: the acceptance holds only while the vendor shows progress.";

// --- 4. derives_from (24 edges) --------------------------------------------------------
UNWIND [
  {h: "principle:residual-risk-stated-and-owned", key: "name", val: "NIST SP 800-37 Rev. 2, Risk Management Framework for Information Systems and Organizations (2018)", kind: "design_choice", provision: "Authorize step, Task R-4 Authorization Decision, Discussion", quote: "The explicit acceptance of risk is the responsibility of the authorizing official and cannot be delegated to other officials within the organization.", why: "NIST makes the acceptance of residual risk an explicit, signed act by one named official, and the only act that official cannot delegate. The warning level names the signer who accepts what the plan leaves uncovered."},
  {h: "principle:residual-risk-stated-and-owned", key: "name", val: "Washington State OCIO, SEC-11 Risk Management Policy (2023)", kind: "design_choice", provision: "Policy statements, risk treatment", quote: "Residual risk must be accepted by an agency officer authorized to make risk treatment decisions. Approval authority may be delegated if documented in writing, but ultimate responsibility for risk acceptance cannot be delegated.", why: "A state policy applies the same rule to residual risk after treatment, which is the risk a TAAP leaves. The officer who accepts it is named and keeps the responsibility."},
  {h: "principle:residual-risk-stated-and-owned", key: "unique_id", val: "84b6d27b2c464bd69199b502f48c46ca", kind: "interpretation", provision: "Risk Mitigations", quote: "Accommodation plan and/or alternate means plan addresses all defects (Low -1)", why: "The federal model scores the alternate access plan's coverage as the mitigation that lowers risk, and a missing plan as the heaviest addition. That is the gap term of the warning, the requirements a plan leaves uncovered."},
  {h: "principle:residual-risk-stated-and-owned", key: "name", val: "HM Treasury, The Orange Book: Management of Risk, Principles and Concepts (2004)", kind: "design_choice", provision: "Section 4.4, Assessing risks", quote: "It is not the absolute value of an assessed risk which is important; rather it is whether or not the risk is regarded as tolerable, or how far the exposure is away from tolerability, which is important.", why: "The warning reports how far above the binding minimum an approval sits, and why. It never reports a score on its own and never moves the minimum."},
  {h: "principle:residual-risk-stated-and-owned", key: "name", val: "Budescu, Por, Broomell and Smithson, The interpretation of IPCC probabilistic statements around the world (2014)", kind: "scholarship", provision: "Abstract", quote: "laypeople interpret IPCC statements as conveying probabilities closer to 50% than intended by the IPCC authors", why: "Verbal grades drift toward the middle of the scale unless the numbers appear with the word. The pressure and the gap print beside the warning level every time."},
  {h: "principle:residual-risk-stated-and-owned", key: "unique_id", val: "45ad1531fbb14e7899c672fef755ce90", kind: "scholarship", provision: "The risk matrix theorem", quote: null, why: "Cox shows that a few ordinal bins give the same label to very different risks. Three warning levels compress pressure, gap and severity, so the label carries its components and a sentence rather than standing alone. No source text is held for this article."},
  {h: "principle:residual-risk-stated-and-owned", key: "name", val: "University of Washington, Digital Product Accessibility Reviews", kind: "design_choice", provision: "Step 2, Scope and Risk Review, What you'll get", quote: "Risk score and notes providing details for why the product received its risk level", why: "A peer university sends the purchaser the score and the reasons with the level, never the level alone."},
  {h: "principle:residual-risk-stated-and-owned", key: "name", val: "University of Arizona, Accessible Procurement Process", kind: "design_choice", provision: "Exception Approval", quote: "High risk exceptions: Steering Committee approval required", why: "A peer maps the risk level to the approver, and every exception records who is affected and how, the mitigation, the remediation timeline and the review date. The warning level maps to the signer who acknowledges it."},
  {h: "principle:residual-risk-stated-and-owned", key: "name", val: "Minnesota IT Services, Updating Minnesota's Accessibility Exceptions Process, Part 2 (2025)", kind: "design_choice", provision: "Part 2, the exceptions workflow", quote: null, why: "Minnesota's exception has the agency acknowledge the barriers, accept the risk and plan mitigation, and the risk level tells it whether to proceed and what further steps follow. The state keeps a dashboard of exceptions in force, which a graded label makes possible. The page refuses automated requests, so no text is stored and no quotation is given."},
  {h: "principle:residual-risk-stated-and-owned", key: "name", val: "Texas DIR, EIR Accessibility Requirements, Exceptions, and Exemptions", kind: "design_choice", provision: "Exceptions", quote: "Providing individuals with disabilities an alternate method of access if an exception is determined by the head of the agency or institution", why: "Texas puts the exception with the head of the institution and attaches alternate access to it. The acceptance of residual access risk is an executive act with a named owner."},
  {h: "principle:residual-risk-stated-and-owned", key: "name", val: "Big Ten Academic Alliance, ITAG Accessibility Prioritization Guide", kind: "design_choice", provision: "Medium / Phased Priority Description", quote: "It may be necessary to implement a plan for providing Equally Effective Alternate Access and to develop a remediation roadmap and timeline for correcting accessibility flaws.", why: "Peers pair the alternate access plan with a remediation roadmap and timeline. The warning's action names the roadmap milestone at which the acceptance is reviewed."},
  {h: "principle:time-bound-alternative-when-not-conformant", key: "unique_id", val: "84b6d27b2c464bd69199b502f48c46ca", kind: "interpretation", provision: "Risk Mitigations", quote: "Remediation of defects completed in more than 12 months (High +5)", why: "Remediation time is the federal model's heaviest driver. A TAAP is valid only while the vendor remediates, so the acceptance is reviewed at the first roadmap milestone."},
  {h: "principle:time-bound-alternative-when-not-conformant", key: "name", val: "University of Washington, Digital Product Accessibility Reviews", kind: "design_choice", provision: "Step 6, Provisional Approval, What you'll get", quote: "An expiration date when the product will need to be reviewed again", why: "A peer attaches an expiration date to every provisional approval and exemption."},
  {h: "principle:time-bound-alternative-when-not-conformant", key: "name", val: "University of Arizona, Accessible Procurement Process", kind: "design_choice", provision: "Exception Requirements", quote: "Review date: When the exception will be reconsidered", why: "A peer records the review date with every exception."},
  {h: "principle:deference-earned-through-documented-process", key: "name", val: "Washington State OCIO, SEC-11 Risk Management Policy (2023)", kind: "design_choice", provision: "Risk acceptance", quote: "The agency risk owners must sign off that they accept residual risks identified during the risk assessment.", why: "The record of acceptance is a signature by the risk owner against the identified residual risks. The TAAP signatures and the warning level together are that record."}
] AS row
MATCH (p:Principle {handle: row.h})
MATCH (g:IntellectualSource)
WHERE (row.key = "unique_id" AND g.unique_id = row.val) OR (row.key = "name" AND g.name = row.val) OR (row.key = "title" AND g.title = row.val)
MERGE (p)-[r:derives_from]->(g)
ON CREATE SET r.grounding_kind = row.kind, r.provision = row.provision, r.quote = row.quote,
              r.rationale = row.why, r.assessed_date = date("2026-10-20");

UNWIND [
  {h: "principle:residual-risk-stated-and-owned", key: "unique_id", val: "34a1e0763aaa4b2c80dfb8cc672fbb36", kind: "interpretation", provision: "ICT Accessibility and Risk Management, Addressing the Risk", quote: "Acceptance: Acknowledge the risk within defined tolerance levels and document the rationale.", why: "Federal accessibility guidance defines acceptance as acknowledgement within a tolerance plus a recorded rationale. The TAAP standard is the tolerance, and the warning is the rationale the record keeps. The same page defines each of its six ratings by the attention it requires, which is the form the warning levels take."}
] AS row
MATCH (p:Principle {handle: row.h})
MATCH (g:Directive)
WHERE (row.key = "unique_id" AND g.unique_id = row.val) OR (row.key = "name" AND g.name = row.val) OR (row.key = "title" AND g.title = row.val)
MERGE (p)-[r:derives_from]->(g)
ON CREATE SET r.grounding_kind = row.kind, r.provision = row.provision, r.quote = row.quote,
              r.rationale = row.why, r.assessed_date = date("2026-10-20");

UNWIND [
  {h: "principle:residual-risk-stated-and-owned", key: "unique_id", val: "f27b3d0274b14aa19ff7492b68b073bb", kind: "mandate", provision: "Administrative Approval", quote: "evaluated the associated institutional risks and accommodation requirements, and determined that this plan serves as an acceptable interim solution", why: "The CSU template already makes the three signers the officers who accept the plan's risk. The warning level tells them, in consequence terms, what they accept."},
  {h: "principle:residual-risk-stated-and-owned", key: "unique_id", val: "749610aedade4c709d784c10cd36dbb0", kind: "mandate", provision: "Step 2, Determine impact", quote: "Access to a program/service may be denied", why: "The CSU names the consequences that make a purchase high impact: denied access, a critical program, high accommodation cost, significant legal exposure and no known workaround. A warning stated by consequence uses the same list."},
  {h: "principle:residual-risk-stated-and-owned", key: "title", val: "SFSU, Determining Impact of a Technology Acquisition", kind: "mandate", provision: "High impact", quote: "Creates significant legal exposure", why: "The campus adaptation of the CSU framework counts legal exposure and accommodation cost as consequences of impact, alongside denied access. The warning sentence names the duty that continues and what the department carries."},
  {h: "principle:prioritization-by-impact", key: "title", val: "SFSU, Determining Impact of a Technology Acquisition", kind: "mandate", provision: "High impact", quote: "Impacts a large audience or members of the public", why: "The campus adaptation of the CSU framework rates probability by audience size and public exposure. The pressure term of the review matrix carries the same facts."},
  {h: "principle:prioritization-by-impact", key: "title", val: "CSU Channel Islands, IT Procurement Impact Assessment Scoring", kind: "mandate", provision: "About Your Product Score", quote: "If your score is 35 or above: this procurement is considered to be a high-risk, high-impact", why: "A CSU campus scores impact numerically, with one threshold that triggers VPAT review, testing and an EEAAP."},
  {h: "principle:prioritization-by-impact", key: "title", val: "CSU Bakersfield, Procurement of Accessible ICT training (2021)", kind: "design_choice", provision: "Accessibility Risk Assessment, Probability", quote: "Strong likelihood of impact for persons with disabilities.", why: "The CSU framework as a campus teaches it has two axes, impact and probability, with audience, recurrence and likelihood on the probability axis."},
  {h: "principle:severity-from-task-impact", key: "title", val: "CSU Bakersfield, Procurement of Accessible ICT training (2021)", kind: "design_choice", provision: "Accessibility Risk Assessment, Impact", quote: "Denies access to a program/service.", why: "The CSU framework ranks denial of access above limitation of access. The warning sentence says which the finding is, since the level alone does not."},
  {h: "principle:severity-from-task-impact", key: "title", val: "SFSU, Determining Impact of a Technology Acquisition", kind: "mandate", provision: "Medium Impact", quote: "Limits access to a program/service for people with disabilities", why: "The middle tier is limitation and the top tier denial, which is the S2 and S3 distinction."}
] AS row
MATCH (p:Principle {handle: row.h})
MATCH (g:Guideline)
WHERE (row.key = "unique_id" AND g.unique_id = row.val) OR (row.key = "name" AND g.name = row.val) OR (row.key = "title" AND g.title = row.val)
MERGE (p)-[r:derives_from]->(g)
ON CREATE SET r.grounding_kind = row.kind, r.provision = row.provision, r.quote = row.quote,
              r.rationale = row.why, r.assessed_date = date("2026-10-20");
