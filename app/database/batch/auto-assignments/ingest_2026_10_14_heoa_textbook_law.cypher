SET d.provision = "¶3", d.quote = "All adopters of course materials, primarily faculty and academic departments, should submit their course material selections, including information if there will be no materials to purchase, to the appropriate CSU campus bookstore by the requested due date to allow for adequate research and confirmation of information and costs to students.", d.note = "The memo sets the systemwide expectation that adopters submit selections to the campus bookstore by the campus due date. A campus process for timely adoption is the mechanism that meets it. The memo attributes this sentence to AB 607 (2023).";
