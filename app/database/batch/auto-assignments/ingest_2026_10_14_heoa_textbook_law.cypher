MATCH (g:Law {title: "Higher Education Opportunity Act of 2008, Section 133: Textbook Information (20 U.S.C. 1015b)"})
MATCH (s:SuccessIndicator {composite_key: "1.2-ins"})
MERGE (g)-[d:drives]->(s)
ON CREATE SET d.added_date = date("2026-10-14")
SET d.provision = "§133(d)(1)", d.quote = "To the maximum extent practicable, each institution of higher education receiving Federal financial assistance shall— (1) disclose, on the institution's Internet course schedule and in a manner of the institution's choosing, the International Standard Book Number and retail price information of required and recommended college textbooks and supplemental materials for each course listed in the institution's course schedule used for preregistration and registration purposes", d.note = "The statute sets the latest point at which adoptions must be known: the course schedule used for preregistration and registration. A timely adoption process has to deliver selections before that point. CSU Affordable Learning Solutions states that on-time adoption allows time to locate alternative formatted materials for students with disabilities.";

MATCH (g:Memo {title: "CSU Memorandum: Supporting Student Success through Compliance with the HEOA Course Materials Disclosure (2026)"})
MATCH (goal:Goal {unique_id: "0ef34370-d172-41a7-ad97-cfcd678cebe5"})
