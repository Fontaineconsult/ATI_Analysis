// --- 1. Intellectual sources (42) ---------------------------------------------------
UNWIND [
  {name: "DeLancey, Assessing the accuracy of vendor-supplied accessibility documentation (2015)", author: "Laura DeLancey", publisher: "Library Hi Tech", pd: null, citation: "DeLancey, L. (2015). Assessing the accuracy of vendor-supplied accessibility documentation. Library Hi Tech, 33(1), 103-113. doi:10.1108/LHT-08-2014-0077", url: "https://digitalcommons.wku.edu/dlts_fac_pub/23", short: "Compares 17 library vendors' VPATs with automated scans and finds errors in 16 of them.", full: "A peer-reviewed study that checked vendor VPATs against automated accessibility scans of three pages per resource. Discrepancies appeared in 16 of 17 VPATs, and 19.6 percent of 189 checkpoints were wrong. Because the scans were automated and shallow, the error rate is a floor. The author concludes that vendor documentation requires verification and follow-up."},
  {name: "Willis and O'Reilly, Filling the Gap in Database Usability (2020)", author: "Samuel K. Willis; Faye O'Reilly", publisher: "Information Technology and Libraries", pd: null, citation: "Willis, S. K., and O'Reilly, F. (2020). Filling the Gap in Database Usability: Putting Vendor Accessibility Compliance to the Test. Information Technology and Libraries, 39(4). doi:10.6017/ital.v39i4.11977", url: "https://ital.corejournals.org/index.php/ital/article/view/11977", short: "Manual testing of 227 library databases found only 10 that fully matched their VPAT claims.", full: "A peer-reviewed study that manually tested every database a university library subscribes to against 11 criteria the vendors claimed in their VPATs. Only 10 of 227 fully matched, and bypass blocks was the commonest mismatch. The authors attribute mismatches to outdated VPATs and to vendors not understanding what usable access requires. The platforms changed during the work, which shows that a VPAT describes one version at one time."},
  {name: "Willis and O'Reilly, Enhancing Visibility of Vendor Accessibility Documentation (2018)", author: "Samuel K. Willis; Faye O'Reilly", publisher: "Information Technology and Libraries", pd: null, citation: "Willis, S. K., and O'Reilly, F. (2018). Enhancing Visibility of Vendor Accessibility Documentation. Information Technology and Libraries, 37(3), 12-28. doi:10.6017/ital.v37i3.10240", url: "https://doi.org/10.6017/ital.v37i3.10240", short: "Finds that most of a library's vendors had no VPAT available online.", full: "A peer-reviewed study of how available vendor accessibility documentation is to a library buyer. Only 15 percent of the library's vendors had a VPAT findable online, and 16 percent more supplied one on request. The study shows that a missing report is common and cannot be read as evidence of conformance."},
  {name: "Zavala and Reidsma, Trust, But Verify: Auditing Vendor-Supplied Accessibility Claims (2020)", author: "Melina Zavala; Matthew Reidsma", publisher: "The Code4Lib Journal", pd: "2020-05-11", citation: "Zavala, M., and Reidsma, M. (2020). Trust, But Verify: Auditing Vendor-Supplied Accessibility Claims. The Code4Lib Journal, Issue 48.", url: "https://journal.code4lib.org/articles/15122", short: "A short spot check of seven library platforms found unreported accessibility issues at every vendor.", full: "An editorially reviewed journal article describing a three-to-five-minute spot check of headings, alt text, form structure, contrast and keyboard use, drawn from 65 Big Ten Academic Alliance reports. Every vendor tested had issues its VPAT did not report, and the vendor claiming full compliance performed worst. The authors treat a VPAT that claims Supports on every row as a red flag."},
  {name: "Prioritizing Accessibility in the E-Resources Procurement Lifecycle", author: "Krista A. Falloon; Faye M. O'Reilly", publisher: "The Serials Librarian", pd: null, citation: "Falloon, K. A., and O'Reilly, F. M. (2020). Prioritizing Accessibility in the E-Resources Procurement Lifecycle: VPATs as a Practical Tool for E-Resource Acquisitions and Remediation Workflows at Academic Libraries. The Serials Librarian, 78(1-4), 130-140. doi:10.1080/0361526X.2020.1722020", url: "https://doi.org/10.1080/0361526X.2020.1722020", short: "A two-university case study of using VPATs in library procurement.", full: "A peer-reviewed case study of how two academic libraries use VPATs in acquisition and remediation workflows. It finds VPATs hard to interpret and not always reliable, and recommends verification and functional testing. Read from the abstract only, because the full text was not available."},
  {name: "McNeilly and Bahram, How to Read a VPAT: Assessing Accessibility Conformance Reports (2019)", author: "Brian McNeilly; Sina Bahram", publisher: "MW19: Museums and the Web", pd: "2019-01-31", citation: "McNeilly, B., and Bahram, S. (2019). How to Read a VPAT: Assessing Accessibility Conformance Reports. MW19: Museums and the Web, Boston.", url: "https://mw19.mwconf.org/paper/how-to-read-a-vpat-assessing-accessibility-conformance-reports/", short: "A conference paper giving red flags and a five-part test for a credible ACR.", full: "A conference paper by a University of Washington accessibility lead and a consultant, linked from the Section508.gov ACR library. It treats Supports on every row, blank or restated remarks, unexplained Not Applicable and outdated templates as red flags. Its test of a credible ACR asks for a third-party author, an explained method, varied assistive technology with versions, positive examples and public availability."},
  {name: "Brajnik, Yesilada and Harper, Is accessibility conformance an elusive property? (2012)", author: "Giorgio Brajnik; Yeliz Yesilada; Simon Harper", publisher: "ACM Transactions on Accessible Computing", pd: null, citation: "Brajnik, G., Yesilada, Y., and Harper, S. (2012). Is accessibility conformance an elusive property? A study of validity and reliability of WCAG 2.0. ACM Transactions on Accessible Computing, 4(2), Article 8. doi:10.1145/2141943.2141946", url: "https://doi.org/10.1145/2141943.2141946", short: "Shows that experienced evaluators rarely reach 80 percent agreement on WCAG 2.0 conformance.", full: "A peer-reviewed study of the validity and reliability of WCAG 2.0 conformance judgments. An 80 percent agreement level among experienced evaluators almost never occurred. Two pooled experts found at most 76 percent of the true problems, with 24 percent false positives. One evaluator's conformance verdict therefore carries substantial error."},
  {name: "Brajnik, Yesilada and Harper, Testability and Validity of WCAG 2.0: The Expertise Effect (2010)", author: "Giorgio Brajnik; Yeliz Yesilada; Simon Harper", publisher: "ASSETS 2010", pd: null, citation: "Brajnik, G., Yesilada, Y., and Harper, S. (2010). Testability and validity of WCAG 2.0: the expertise effect. Proceedings of ASSETS 2010, 43-50. doi:10.1145/1878803.1878813", url: "https://doi.org/10.1145/1878803.1878813", short: "Measures how much experts and non-experts disagree and err when judging WCAG 2.0 conformance.", full: "A peer-reviewed study of 22 experts and 27 non-experts evaluating against WCAG 2.0. About half the success criteria failed to reach 80 percent agreement. Experts produced about 20 percent false positives and missed about 32 percent of true problems, and non-experts did markedly worse."},
  {name: "Brajnik, Yesilada and Harper, The Expertise Effect on Web Accessibility Evaluation Methods (2011)", author: "Giorgio Brajnik; Yeliz Yesilada; Simon Harper", publisher: "Human-Computer Interaction", pd: null, citation: "Brajnik, G., Yesilada, Y., and Harper, S. (2011). The Expertise Effect on Web Accessibility Evaluation Methods. Human-Computer Interaction, 26(3), 246-283. doi:10.1080/07370024.2011.601670", url: "https://doi.org/10.1080/07370024.2011.601670", short: "Shows that a few experts find what many non-experts miss in an accessibility evaluation.", full: "A peer-reviewed study of Barrier Walkthrough evaluations by 19 experts and 57 non-experts. Results stabilise with about five experts but not with non-experts, and three experts find all problems where about fourteen non-experts are needed. Who performed an evaluation bears directly on how far its findings can be trusted."},
  {name: "Vigo, Brown and Conway, Benchmarking web accessibility evaluation tools (2013)", author: "Markel Vigo; Justin Brown; Vivienne Conway", publisher: "W4A 2013", pd: null, citation: "Vigo, M., Brown, J., and Conway, V. (2013). Benchmarking web accessibility evaluation tools: measuring the harm of sole reliance on automated tests. Proceedings of W4A 2013. doi:10.1145/2461121.2461124", url: "https://doi.org/10.1145/2461121.2461124", short: "Measures how little of WCAG automated tools can check.", full: "A peer-reviewed benchmark of six automated accessibility tools against WCAG 2.0. The tools caught between 14 and 38 percent of issues, and the more complete tools were less often correct. A conformance report built only on automated testing cannot support a Supports claim on most criteria."},
  {name: "Power, Freire, Petrie and Swallow, Guidelines are only half of the story (2012)", author: "Christopher Power; Andre Freire; Helen Petrie; David Swallow", publisher: "CHI 2012", pd: null, citation: "Power, C., Freire, A. P., Petrie, H., and Swallow, D. (2012). Guidelines are only half of the story: accessibility problems encountered by blind users on the web. Proceedings of CHI 2012, 433-442. doi:10.1145/2207676.2207736", url: "https://doi.org/10.1145/2207676.2207736", short: "Finds that WCAG covers only half the problems blind users meet, and that its levels do not predict severity.", full: "A peer-reviewed study of 32 blind users on 16 websites, who met 1,383 problems and rated each from cosmetic to catastrophic. Only 50.4 percent of the problems were covered by WCAG 2.0 success criteria. The authors conclude that the WCAG priority levels are too crude a measure of accessibility, so severity has to be judged by the effect on users."},
  {name: "Petrie and Kheir, The relationship between accessibility and usability of websites (2007)", author: "Helen Petrie; Omar Kheir", publisher: "CHI 2007", pd: null, citation: "Petrie, H., and Kheir, O. (2007). The relationship between accessibility and usability of websites. Proceedings of CHI 2007, 397-406. doi:10.1145/1240624.1240688", url: "https://doi.org/10.1145/1240624.1240688", short: "Finds that users agree on problem severity but that their ratings do not match guideline priority levels.", full: "A peer-reviewed study comparing accessibility and usability problems met by blind and sighted users. Participants agreed with each other, and with the researchers, on how severe problems were. Those ratings showed no significant agreement with the priority levels in the guidelines."},
  {name: "Brajnik, Barrier Walkthrough", author: "Giorgio Brajnik", publisher: "WISE 2008 Workshops, Lecture Notes in Computer Science", pd: null, citation: "Brajnik, G. (2008). Measuring Web Accessibility by Estimating Severity of Barriers. Web Information Systems Engineering, WISE 2008 Workshops, LNCS, 112-121. doi:10.1007/978-3-540-85200-1_13", url: "https://users.dimi.uniud.it/~giorgio.brajnik/projects/bw/bw.html", short: "Sets out Barrier Walkthrough, which rates each barrier's severity against a user group and a goal.", full: "A peer-reviewed workshop paper setting out the Barrier Walkthrough method. Each barrier is rated minor, major or critical for a named user category and goal, by its effect on effectiveness, productivity, satisfaction or safety and by how often it occurs. It is the main published method for turning a conformance failure into a context-dependent severity."},
  {name: "Hertzum, Molich and Jacobsen, What you get is what you see: revisiting the evaluator effect (2014)", author: "Morten Hertzum; Rolf Molich; Niels Ebbe Jacobsen", publisher: "Behaviour and Information Technology", pd: null, citation: "Hertzum, M., Molich, R., and Jacobsen, N. E. (2014). What you get is what you see: revisiting the evaluator effect in usability tests. Behaviour and Information Technology, 33(2), 144-162. doi:10.1080/0144929X.2013.783114", url: "https://doi.org/10.1080/0144929X.2013.783114", short: "Shows that professionals often rate the same problem critical and minor.", full: "A peer-reviewed study of 19 usability professionals evaluating the same product. Between 24 and 30 percent of the problems found by more than one professional were rated critical by one and minor by another. The evaluator effect persisted even for the most severe problems. The study is about usability, but it is direct evidence that one rater's severity call needs anchors."},
  {name: "Romen and Svanaes, Validating WCAG versions 1.0 and 2.0 through usability testing with disabled users (2012)", author: "Dagfinn Romen; Dag Svanaes", publisher: "Universal Access in the Information Society", pd: null, citation: "Rømen, D., and Svanæs, D. (2012). Validating WCAG versions 1.0 and 2.0 through usability testing with disabled users. Universal Access in the Information Society, 11(4), 375-385. doi:10.1007/s10209-011-0259-3", url: "https://doi.org/10.1007/s10209-011-0259-3", short: "Finds that WCAG catches only a minority of the problems disabled users meet.", full: "A peer-reviewed study comparing WCAG checks with usability testing by disabled users. Only 27 percent of the problems users met could have been found with WCAG 1.0, and WCAG 2.0 added about 5 percent. Conformance alone does not show what users will meet."},
  {name: "GSA, Accessibility Risk Management and Risk Model for ICT (2023)", author: "Rebecca Lovley (FCC)", publisher: "Section508.gov, U.S. General Services Administration", pd: null, citation: "U.S. General Services Administration, Section508.gov. Accessibility Risk Management and Risk Model for ICT. Contributor Rebecca Lovley, Federal Communications Commission. Reviewed September 2023.", url: "https://www.section508.gov/blog/Accessibility-risk-management-and-model/", short: "A federal example model that scores ICT accessibility risk from scope of use, defect impact, history, vendor expertise and mitigations.", full: "A risk model published on Section508.gov as an example for agencies. It sums points across scope of use, impact of defects, product history, vendor expertise and mitigations, with high risk at 25 points. Defects affecting three or more disability groups or critical features score highest. It is guidance and a model, so it binds no one, and the agency is told to set its own thresholds."},
  {name: "GSA, Understanding Vendor Claims in Accessibility Conformance Reports (2023)", author: null, publisher: "Section508.gov, U.S. General Services Administration", pd: null, citation: "U.S. General Services Administration, Section508.gov. Understanding Vendor Claims in Accessibility Conformance Reports for Section 508 Conformance. Reviewed September 2023.", url: "https://www.section508.gov/buy/understand-claims/", short: "Federal guidance on reading each ACR conformance term, which treats Partially Supports as non-conformance.", full: "Federal guidance for buyers on the ACR conformance terms. It reads Partially Supports as non-conformance, says Not Evaluated gives no assurance, and tells purchasers to verify claims by independent testing whenever possible. It gives no severity method."},
  {name: "MN.IT, VPAT Evaluation Scoring for RFPs (2013)", author: null, publisher: "MN.IT Services, Office of Accessibility (State of Minnesota)", pd: null, citation: "MN.IT Services Office of Accessibility. VPAT Evaluation Scoring for RFPs (draft). State of Minnesota, December 2013.", url: "https://mn.gov/mnit/images/VPAT_Scoring_Guidance.pdf", short: "A state rubric that scores VPATs from 0 to 10 and treats blanket claims of full support as near worthless.", full: "A draft scoring guide for evaluating VPATs in state RFPs. It scores 0 to 10, says most VPATs should look like a bug list, and caps blanket claims at 3. It scores the quality of the comments and the stated accessibility separately. It predates WCAG 2.1 and the refreshed Section 508 standards."},
  {name: "Evaluate Compliance Documentation (University of Michigan)", author: null, publisher: "University of Michigan", pd: null, citation: "University of Michigan. Evaluate Compliance Documentation, with the VPAT Review Template.", url: "https://accessibility.umich.edu/how-to/procurement-vendors/evaluate-compliance", short: "A university rubric that scores VPAT documentation and adjusts the score when testing contradicts it.", full: "A university procedure and scoring workbook for vendor accessibility documentation. It sets a general score with warning signs for age, template version and method, and a per-criterion score that rewards explained remarks. A supplemental modifier from plus 3 to minus 3 applies when the product proves more or less accessible than its VPAT. It scores documentation, not severity."},
  {name: "UW Libraries, Libraries E-Resource Accessibility Testing", author: null, publisher: "University of Washington Libraries", pd: null, citation: "University of Washington Libraries. Libraries E-Resource Accessibility Testing.", url: "https://lib.uw.edu/about/accessibility/libraries-e-resource-accessibility-testing/", short: "A library risk score that combines a keyboard test with a VPAT score.", full: "A university library procedure that rates e-resources from 0 to 10 by adding a keyboard test of search, retrieval and use to a VPAT score. A disagreement between the VPAT and the keyboard test adds points. Poor scores lead to deeper evaluation and possible non-renewal."},
  {name: "University of Arkansas, About VPAT", author: null, publisher: "University of Arkansas Information Technology Services", pd: null, citation: "University of Arkansas IT Services. About VPAT (knowledge base article).", url: "https://uark.teamdynamix.com/TDClient/33/Portal/KB/ArticleDet?ID=667", short: "A university rubric that averages a criteria-coverage band with a documentation band.", full: "A university rubric, adapted from Minnesota's, that averages a score for the share of applicable criteria supported with a score for documentation quality. A total of 3 or less, or no VPAT, triggers hands-on review. It ties outcomes to vendor commitments to supply an acceptable VPAT."},
  {name: "University of Arizona, VPAT Review Guide", author: null, publisher: "University of Arizona Digital Accessibility", pd: null, citation: "University of Arizona Digital Accessibility. VPAT Review Guide; Accessible Procurement Process.", url: "https://accessibility.arizona.edu/procurement/vpat-review", short: "A university guide that turns the share of Supports rows into approve, conditional approval or seek alternatives.", full: "A university review guide that weights Supports, Partially Supports and Does Not Support rows and maps the share of support to a decision. 80 percent or more supports approval, 60 to 80 percent supports conditional approval with a remediation plan, and less supports seeking alternatives. It names five priority criteria and treats a keyboard failure as a strong sign of deeper problems."},
  {name: "University of Vermont, VPAT and ACR Evaluations", author: null, publisher: "University of Vermont Office of Accessibility Services", pd: null, citation: "University of Vermont, Office of Accessibility Services. VPAT and ACR Evaluations.", url: "https://www.uvm.edu/accessibility-services/vpat-acr-evaluations", short: "A university pass or fail rubric of 16 report-quality items, graded A to F.", full: "A university rubric that grades the quality of an ACR on 16 pass or fail items: age, template version, evaluator, method, editions, complete tables, explained Not Applicable rows, and no Supports claim contradicted by its own notes. It states that the review does not reject products automatically."},
  {name: "University of Nebraska, Accessibility risk rubric", author: null, publisher: "University of Nebraska Information Technology Services", pd: null, citation: "University of Nebraska ITS. Accessibility risk rubric.", url: "https://nebraska.edu/offices/information-technology-services/technology-support/accessibility/accessibility-risk-rubric", short: "A university risk rubric that combines audience size, evidence type and a manual test.", full: "A university rubric that rates accessibility risk from the number of users or public exposure, the kind of evidence (third-party VPAT, self-disclosed VPAT, none), and the result of a manual test. No VPAT with a large or public audience rates high."},
  {name: "UW-Madison, Interpreting Vendor Accessibility Responses", author: null, publisher: "University of Wisconsin-Madison", pd: null, citation: "University of Wisconsin-Madison, Accessibility and Usability. Interpreting Vendor Accessibility Responses.", url: "https://accessible.wisc.edu/interpreting-vendor-accessibility-responses", short: "University guidance that defines the conformance terms by whether the defects present a significant barrier.", full: "University guidance on reading vendor responses. It defines Partially Supports as defects that do not present a significant barrier and Does Not Support as defects that do, and shows how vague remarks hide where a failure sits. It tells reviewers to ask where each issue occurs, what the workaround is, and what it does to users."},
  {name: "UC Berkeley, Accessible Technology Procurement Review Process", author: null, publisher: "UC Berkeley Digital Accessibility Program", pd: null, citation: "UC Berkeley Digital Accessibility Program. Accessible Technology Procurement Review Process.", url: "https://dap.berkeley.edu/node/177", short: "A university procurement process that requires a recent ACR and more testing when it cannot be verified.", full: "A university procurement review process. The ACR must be from the past 12 to 18 months, an incomplete or unverifiable report leads to additional testing, and blocker-level issues must be addressed urgently with remediation dates from the vendor."},
  {name: "BTAA, Digital Accessibility Vendor Cookbook", author: null, publisher: "Big Ten Academic Alliance IT Accessibility Group", pd: null, citation: "Big Ten Academic Alliance IT Accessibility Group. Digital Accessibility Vendor Cookbook.", url: "https://btaa.org/technology/itaccessibility/vendor-cookbook", short: "Consortium guidance to vendors on what valid accessibility documentation requires.", full: "Guidance from a consortium of research universities to vendors. It requires current documentation on the active version and template, says valid documentation requires manual accessibility evaluation, and rejects overlays and workarounds as a compliance approach."},
  {name: "Colorado State University, Purchasing Technology/Procurement", author: null, publisher: "Colorado State University", pd: null, citation: "Colorado State University, Accessibility. Purchasing Technology/Procurement.", url: "https://accessibility.colostate.edu/procurement/", short: "University procurement guidance that treats a flawless ACR as a warning sign.", full: "University procurement guidance stating that a completed ACR does not mean a product is accessible, and that a flawless ACR is not realistic and raises questions about the vendor's understanding. Products with issues may be adopted with a roadmap and an equitable alternative."},
  {name: "University of Iowa, Reading and Interpreting a VPAT (2018)", author: null, publisher: "University of Iowa IT Accessibility", pd: "2018-06-15", citation: "University of Iowa IT Accessibility. Reading and Interpreting a VPAT. June 15, 2018.", url: "https://itaccessibility.uiowa.edu/node/801", short: "University guidance that treats an ACR as the vendor's document, not an authority.", full: "Short university guidance on reading a VPAT. It says an ACR is created by and for the vendor and should not be considered authoritative, tells reviewers to verify Supports claims and note the risks in Partially Supports, and flags Does Not Support as high risk."},
  {name: "CAUDIT, Interpreting Accessibility Conformance Reports (and VPATs)", author: null, publisher: "Council of Australasian University Directors of Information Technology", pd: null, citation: "CAUDIT. Interpreting Accessibility Conformance Reports (and VPATs). Accessible IT Procurement Guide.", url: "https://www.caudit.edu.au/accessible-it-procurement/guide/acrs-and-vpats", short: "Australasian university guidance on red flags in a conformance report.", full: "Procurement guidance from the Australasian university IT directors. It prefers an independent third-party author and reads an inaccurate product description as a sign the author does not know the product. It flags Passes or Fails wording, reports claiming everything is supported, and Partially Supports rows without a description of the barriers."},
  {name: "WebAIM, Making VPATs and ACRs More Effective in Procurement (2024)", author: null, publisher: "WebAIM, Utah State University", pd: null, citation: "WebAIM. Making VPATs and ACRs More Effective in Procurement. Updated January 31, 2024.", url: "https://webaim.org/articles/procurement/vpat/", short: "Guidance on scoring ACR items and on what a Partially Supports remark must say.", full: "An article from a university-based accessibility organization on using ACRs in procurement. It scores items from 0 to 4 by the evidence of conformance, treats general product knowledge as an evaluation method as a red flag, and requires remarks on every row. For Partially Supports it asks how the supported part works, where support does and does not exist, and when the gaps close."},
  {name: "Government of Canada, Guide for Including Accessibility in ICT Related Procurement", author: null, publisher: "Government of Canada, Digital Accessibility Toolkit", pd: null, citation: "Government of Canada Digital Accessibility Toolkit. Guide for Including Accessibility in Information and Communication Technology (ICT) Related Procurement.", url: "https://a11y.canada.ca/en/guide-for-including-accessibility-in-information-and-communication-technology-ict-related-procurement/", short: "National procurement guidance on what a conformance report must disclose.", full: "Procurement guidance from the Government of Canada. It asks for an unredacted report by a third party or an in-house accessibility specialist, stating the date, product version, sampling method, and the testing and tools used. Bids are evaluated against EN 301 549, including user testing with people with disabilities."},
  {name: "Roselli, How I Evaluate an ACR (VPAT) (2026)", author: "Adrian Roselli", publisher: "adrianroselli.com", pd: "2026-01-05", citation: "Roselli, A. How I Evaluate an ACR (VPAT). adrianroselli.com, January 5, 2026, updated May 28, 2026.", url: "http://adrianroselli.com/2026/01/how-i-evaluate-an-acr-vpat.html", short: "A practitioner's checklist for evaluating an ACR, from version match to remarks.", full: "A practitioner's method for evaluating an ACR. It checks that the product and version match, that the report is recent, who wrote it, and how it was tested, and it treats one browser and one screen reader as not a thorough review. Every row needs a remark saying what is wrong, and every Not Applicable is worth querying."},
  {name: "Roselli, 1.2.5: Adversarial Conformance (2025)", author: "Adrian Roselli", publisher: "adrianroselli.com", pd: "2025-08-02", citation: "Roselli, A. 1.2.5: Adversarial Conformance. adrianroselli.com, August 2, 2025, updated August 31, 2026.", url: "https://adrianroselli.com/2025/08/1-2-5-adversarial-conformance.html", short: "A practitioner essay on conformance claims that are technically true and still harm users.", full: "A practitioner essay on adversarial conformance: a claim that meets the letter of a success criterion while leaving obvious harm to users. Its discussion also covers how VPAT authors may use Supports where Not Applicable would fit."},
  {name: "Tarnoff, Understanding VPATs and ACRs: Key Insights (2024)", author: "Nat Tarnoff", publisher: "tarnoff.info", pd: "2024-10-14", citation: "Tarnoff, N. Understanding VPATs and ACRs: Key Insights. tarnoff.info, October 14, 2024, updated March 2, 2026.", url: "https://tarnoff.info/2024/10/14/understanding-vpats-and-acrs-key-insights/", short: "A practitioner's rule for rating conformance by the share of failing pages, with a blocker test.", full: "A practitioner's account of how ACR ratings are assigned. It rates Partially Supports and Does Not Support by the share of pages that fail, with a hard line at 50 percent, and decides blockers by the goal of the page. It treats any web ACR older than two years as suspect and notes that a vendor ACR does not cover the buyer's configuration."},
  {name: "Level Access, Understanding VPAT", author: null, publisher: "Level Access", pd: null, citation: "Level Access. Understanding VPAT (help center article).", url: "https://client.levelaccess.com/hc/en-us/articles/32538304986775-Understanding-VPAT", short: "A VPAT author's description of rating conformance by user impact rather than issue count.", full: "A help-center article from a firm that writes VPATs, describing how it assigns ratings. It rates mainly by user impact, so a single severe issue may earn Does Not Support while many minor issues stay Partially Supports. It also says authors typically do not retest the product when they write the VPAT. The firm sells VPATs."},
  {name: "Groves, VPAT Quality: How to Spot a VPAT That Wasn't Properly Tested (2026)", author: "Karl Groves", publisher: "AFixt", pd: null, citation: "Groves, K. VPAT Quality: How to Spot a VPAT That Wasn't Properly Tested. AFixt blog, 2026.", url: "https://afixt.com/vpat-quality-how-to-spot-a-vpat-that-wasnt-properly-tested/", short: "A practitioner's red flags for a VPAT that was not properly tested.", full: "A practitioner article listing signs that a VPAT was not properly tested: no Partially Supports or Does Not Support rows, unexplained ratings, boilerplate remarks, happy-path testing and an old date. It says a thorough VPAT takes about 100 hours of testing. The author's firm sells VPAT reviews. The page date is ambiguous between April and July 2026."},
  {name: "Groves, A quick guide to reviewing a VPAT ACR (2023)", author: "Karl Groves", publisher: "karlgroves.com", pd: "2023-03-27", citation: "Groves, K. A quick guide to reviewing a VPAT ACR. karlgroves.com, March 27, 2023, updated June 13, 2023.", url: "https://karlgroves.com/a-quick-guide-to-reviewing-a-vpat-acr/", short: "A twelve-point practitioner checklist for reviewing an ACR.", full: "A practitioner checklist of twelve checks for an ACR: template age, product description, contacts, scope carve-outs, vague methods, blank remarks, remarks that miss the criterion's intent or hide shortcomings, contradictions between the 508, EN and WCAG tables, and heavy disclaimers."},
  {name: "Groves, Why a Third Party Should Prepare Your VPAT (2011)", author: "Karl Groves", publisher: "karlgroves.com", pd: "2011-07-07", citation: "Groves, K. Why a Third Party Should Prepare Your VPAT. karlgroves.com, July 7, 2011, updated October 21, 2025.", url: "https://karlgroves.com/why-a-third-party-should-prepare-your-vpatgpat/", short: "A practitioner argument that VPAT errors come mostly from lack of expertise.", full: "A practitioner essay arguing that vendor-written VPATs go wrong mainly because vendor staff lack accessibility expertise, not because they lie. It gives examples of Not Applicable used on provisions that clearly applied and of remarks promised and left empty. The author sells third-party VPATs."},
  {name: "AccessibilityOz, How to Read a VPAT (2019)", author: null, publisher: "AccessibilityOz", pd: null, citation: "AccessibilityOz. How to Read a VPAT. September 2019.", url: "https://www.accessibilityoz.com/2019/09/how-to-read-a-vpat/", short: "A practitioner guide that reads Not Evaluated at Level A or AA as Does Not Support.", full: "A practitioner guide to reading a VPAT. It limits Not Applicable to features the product lacks, reads Not Evaluated at Level A or AA as Does Not Support, and treats Passes or Fails wording as a sign of a non-expert author. It gives a four-criterion spot test. The firm sells VPAT development and review."},
  {name: "Evans, Reading a VPAT (2023)", author: "Meryl Evans", publisher: "Equal Entry", pd: "2023-05-24", citation: "Evans, M. Reading a VPAT. Equal Entry, May 24, 2023.", url: "https://equalentry.com/reading-vpat-voluntary-product-accessibility-template/", short: "A practitioner guide on checking remarks, editions and platform coverage in a VPAT.", full: "A practitioner guide to reading a VPAT. Remarks on Partially Supports and Does Not Support rows must identify the function or feature with issues. It checks that Not Applicable still holds for the current version and that each platform has its own report, and warns against treating the report as gospel. The firm sells audits."},
  {name: "Steenhout, Checking 3rd Party Vendors' Product Accessibility (2020)", author: "Nicolas Steenhout", publisher: "Knowbility", pd: "2020-01-08", citation: "Steenhout, N. Checking 3rd Party Vendors' Product Accessibility. Knowbility blog, January 8, 2020.", url: "https://knowbility.org/blog/2020/third-party-vendor-accessibility-check/", short: "Practitioner advice to treat a VPAT as a starting point and run a keyboard test.", full: "A practitioner article from an accessibility nonprofit. It notes that VPATs are sometimes inaccurate, treats the VPAT as only a starting point, and recommends a keyboard-only test of the vendor demonstration, starting with whether keyboard focus is visible."}
] AS row
MERGE (s:IntellectualSource {name: row.name})
ON CREATE SET s.unique_id = replace(randomUUID(), "-", ""), s.author = row.author, s.publisher = row.publisher,
              s.published_date = CASE WHEN row.pd IS NULL THEN null ELSE date(row.pd) END,
              s.citation = row.citation, s.url = row.url,
              s.description_short = row.short, s.description_full = row.full;

// --- 2. is_sourced_from to the existing Section508.gov Webpages ----------------------
UNWIND [
  {name: "GSA, Accessibility Risk Management and Risk Model for ICT (2023)", wid: "6e19ac910227473e9efe276163a3864e"},
  {name: "GSA, Understanding Vendor Claims in Accessibility Conformance Reports (2023)", wid: "9807d32a6a604c839aceaf372ca42d1c"}
] AS row
MATCH (s:IntellectualSource {name: row.name})
MATCH (w:Webpage {unique_id: row.wid})
MERGE (s)-[:is_sourced_from]->(w);

// --- 3. Principles (4) ------------------------------------------------------------
UNWIND [
  {handle: "principle:vendor-claims-require-proportionate-validation", name: "Vendor conformance claims require proportionate validation", short: "A vendor's conformance report is an unverified claim. The institution checks it in proportion to the product's exposure, and a claim the product contradicts counts as no evidence.", full: "An Accessibility Conformance Report is written by or for the vendor, and studies that tested products against their reports found errors in most of them. Automated scans found about one checkpoint in five wrong, which is a floor. Manual testing matched only a handful of products to their claims, and a short spot check found unreported issues at every vendor tested. The report is therefore a lead to be checked, not a finding.

The depth of the check follows the stakes. A product few people use, on a short contract, may rest on a report that passes a quality review. A product with high exposure needs a demonstration, a third-party audit or the institution's own testing before its claims carry weight. When a quick test contradicts the report, the report stops counting as evidence for the rows it got wrong, and its other rows lose credit with it."},
  {handle: "principle:severity-from-task-impact", name: "Severity is judged by the effect on a task", short: "A barrier's severity comes from what it does to a named group of users on a core task. Neither an ACR's conformance label nor a criterion's level (A or AA) says how severe a barrier is.", full: "Conformance reports use three labels, and their authors apply incompatible rules to them. One counts the majority of functionality, another the share of pages, another user impact. A Partially Supports row can hide a blocked login, and a Does Not Support row can describe a cosmetic gap. The level of the failed criterion does not help: studies with disabled users found no reliable link between WCAG priority levels and how severe users found a problem, and found many problems WCAG does not cover at all.

Severity is therefore judged one barrier at a time, for a named user group, by whether it stops, slows or merely inconveniences a core task. A report row becomes a severity finding only when its remark names the feature and the reviewer can place that feature on or off a core task. A row that names no feature leaves the barrier unknown, not minor."},
  {handle: "principle:report-quality-separate-from-accessibility", name: "Report quality and product accessibility are separate measures", short: "How far an ACR can be trusted and how accessible the product is are two measures, scored apart. A report with no reported failures is a warning sign, and a report is valid only for the version, platform and date it covers.", full: "A well-written report can describe an inaccessible product, and a thin report can describe a good one. Institutional rubrics score the report itself: its age, template, author, method, and whether every row carries a remark that says what was tested. Those scores say how much weight the report can bear. They do not say how severe its gaps are, and mixing the two lets a confident document stand in for an accessible product.

Two patterns recur across the guidance. A report that claims full support on every row is treated as a warning sign, because real products have failures and an honest report lists them. A report also describes one version, on one platform, at one time, so a report on another version, an older template or a different platform is evidence about something else."},
  {handle: "principle:severity-calls-need-anchors", name: "Severity calls need anchors", short: "Trained reviewers disagree on conformance and severity often enough that one reviewer's call carries known error. Severity levels need written anchors and worked examples, and a call made from documents alone stays open to testing.", full: "Studies of expert evaluators found that agreement on WCAG conformance rarely reaches 80 percent, that pooled experts still miss a quarter of true problems, and that non-experts do far worse. Professionals rating the same problem called it critical and minor about a quarter of the time, even among the most severe problems. Automated tools check only a minority of criteria. A single verdict, whether from the vendor, a tool or one reviewer, therefore carries error that the process has to plan for.

The remedy is shared reference points: a written definition of each severity level, worked examples of barriers at each level, and the user group and task stated with every call. Calls that rest on a report alone are provisional, and they yield to testing when testing contradicts them."}
] AS row
MERGE (p:Principle {handle: row.handle})
ON CREATE SET p.unique_id = replace(randomUUID(), "-", ""), p.name = row.name,
              p.description_short = row.short, p.description_full = row.full;

// --- 4. derives_from groundings (32) -------------------------------------------------
UNWIND [
  {h: "principle:vendor-claims-require-proportionate-validation", s: "DeLancey, Assessing the accuracy of vendor-supplied accessibility documentation (2015)", provision: "Abstract", quote: "Vendor-supplied accessibility documentation should not be taken at face value, but requires verification and follow up.", rationale: "The study found errors in 16 of 17 vendor VPATs using automated scans alone. It supports treating a vendor report as a claim to verify.", kind: "scholarship"},
  {h: "principle:vendor-claims-require-proportionate-validation", s: "Willis and O'Reilly, Filling the Gap in Database Usability (2020)", provision: "Results", quote: "Of the 227 databases, only 10 databases were found to fully match the claims the vendor made on the VPAT for the 11 criteria assessed.", rationale: "Manual testing found that almost no product matched its VPAT. It supports the claim that reports are wrong more often than right at the row level.", kind: "scholarship"},
  {h: "principle:vendor-claims-require-proportionate-validation", s: "Zavala and Reidsma, Trust, But Verify: Auditing Vendor-Supplied Accessibility Claims (2020)", provision: "Findings", quote: "every vendor we tested had accessibility issues that were not reflected in the VPAT", rationale: "A three-to-five-minute spot check caught unreported issues at every vendor. It supports a cheap validation step even at low exposure.", kind: "scholarship"},
  {h: "principle:vendor-claims-require-proportionate-validation", s: "Prioritizing Accessibility in the E-Resources Procurement Lifecycle", provision: "Abstract", quote: "VPATs as a Practical Tool for E-Resource Acquisitions and Remediation Workflows", rationale: "A procurement case study that finds VPATs useful but unreliable and recommends verification and functional testing. Read from the abstract only, so it is a weak grounding.", kind: "scholarship"},
  {h: "principle:vendor-claims-require-proportionate-validation", s: "GSA, Understanding Vendor Claims in Accessibility Conformance Reports (2023)", provision: "Verify Vendor Conformance Claims", quote: "Whenever possible, purchasers should conduct independent conformance validation testing and evaluation to verify vendor accessibility conformance claims.", rationale: "Federal buyer guidance calls for independent validation of vendor claims. Quote verified against the stored page text. It is guidance, not a rule that binds the CSU.", kind: "interpretation"},
  {h: "principle:vendor-claims-require-proportionate-validation", s: "GSA, Accessibility Risk Management and Risk Model for ICT (2023)", provision: "Risk Scoring", quote: "Your agency should determine the risk score that best fits the risk level.", rationale: "The federal model scales review to a risk score built from scope of use and defect impact. It supports making the depth of validation follow exposure. Quote verified against the stored page text.", kind: "interpretation"},
  {h: "principle:vendor-claims-require-proportionate-validation", s: "UW Libraries, Libraries E-Resource Accessibility Testing", provision: "Accessibility Risk Score", quote: "0 means the resource is very likely to be accessible", rationale: "The library adds points when its keyboard test disagrees with the VPAT. It supports discounting a report that a quick test contradicts.", kind: "interpretation"},
  {h: "principle:vendor-claims-require-proportionate-validation", s: "Evaluate Compliance Documentation (University of Michigan)", provision: "General score", quote: "product reviewed and was more/less accessible than VPAT indicated", rationale: "The rubric adjusts the VPAT score up or down by testing results. It supports letting testing override the report.", kind: "interpretation"},
  {h: "principle:vendor-claims-require-proportionate-validation", s: "BTAA, Digital Accessibility Vendor Cookbook", provision: "Vendor documentation", quote: "Valid compliance documentation requires manual accessibility evaluation.", rationale: "The consortium guidance rejects documentation built without manual evaluation. It supports giving such a report little weight.", kind: "interpretation"},
  {h: "principle:vendor-claims-require-proportionate-validation", s: "Steenhout, Checking 3rd Party Vendors' Product Accessibility (2020)", provision: "Article", quote: "It is not unheard of for VPAT documents to be inaccurate.", rationale: "Practitioner advice to treat the VPAT as a starting point and run a keyboard test of the demonstration.", kind: "interpretation"},
  {h: "principle:severity-from-task-impact", s: "Power, Freire, Petrie and Swallow, Guidelines are only half of the story (2012)", provision: "Results and Conclusions", quote: "Only 50.4% of the problems encountered by users were covered by Success Criteria", rationale: "Blind users met many problems WCAG does not cover, and the authors found the priority levels too crude to measure accessibility. It supports judging severity by the effect on users, not by criterion level.", kind: "scholarship"},
  {h: "principle:severity-from-task-impact", s: "Petrie and Kheir, The relationship between accessibility and usability of websites (2007)", provision: "Abstract", quote: "no significant agreement", rationale: "Users agreed with each other on severity, but their ratings did not match guideline priority levels. It supports separating severity from the level of the failed criterion. Read from the abstract.", kind: "scholarship"},
  {h: "principle:severity-from-task-impact", s: "Brajnik, Barrier Walkthrough", provision: "Title", quote: "Measuring Web Accessibility by Estimating Severity of Barriers", rationale: "Barrier Walkthrough rates each barrier for a named user category and goal. It is the published method the principle follows: severity is relative to a user group and a task.", kind: "scholarship"},
  {h: "principle:severity-from-task-impact", s: "Romen and Svanaes, Validating WCAG versions 1.0 and 2.0 through usability testing with disabled users (2012)", provision: "Title", quote: "Validating WCAG versions 1.0 and 2.0 through usability testing with disabled users", rationale: "Most problems disabled users met were not detectable by WCAG checks. It supports judging severity from task impact rather than from conformance rows. Read from the abstract.", kind: "scholarship"},
  {h: "principle:severity-from-task-impact", s: "UW-Madison, Interpreting Vendor Accessibility Responses", provision: "Conformance terms", quote: "known defects do not present a significant barrier", rationale: "The university defines Partially Supports by whether the defects are a significant barrier, and shows that a vague remark hides where a failure sits. It supports reading a row as severity only when its remark names the feature.", kind: "interpretation"},
  {h: "principle:severity-from-task-impact", s: "Level Access, Understanding VPAT", provision: "How ratings are assigned", quote: "Primarily, we assess user impact. A single severe issue that significantly disrupts the user experience may result in a Does Not Support rating.", rationale: "A VPAT author describes rating by user impact. Set beside the ITI majority-of-functionality definition and Tarnoff's page-share rule, it shows that the labels follow the author's rule, not the product. The firm sells VPATs.", kind: "interpretation"},
  {h: "principle:severity-from-task-impact", s: "Tarnoff, Understanding VPATs and ACRs: Key Insights (2024)", provision: "Blockers", quote: "We determine the blocking status of the issue by focusing on the goal of the page.", rationale: "The blocker test is the task test this principle uses. His page-share rule for the labels is the counter-reading, recorded separately.", kind: "interpretation"},
  {h: "principle:severity-from-task-impact", s: "Roselli, 1.2.5: Adversarial Conformance (2025)", provision: "Essay", quote: "Adversarial Conformance", rationale: "A claim can meet the letter of a criterion and still harm users. It supports judging severity by what users meet rather than by the conformance claim.", kind: "interpretation"},
  {h: "principle:report-quality-separate-from-accessibility", s: "MN.IT, VPAT Evaluation Scoring for RFPs (2013)", provision: "Scoring", quote: "most VPATs should look like a bug list", rationale: "The state rubric scores the comments and the stated accessibility separately, and scores blanket claims of full support near zero. It supports scoring report quality apart from accessibility and treating a clean report as a warning sign.", kind: "interpretation"},
  {h: "principle:report-quality-separate-from-accessibility", s: "University of Vermont, VPAT and ACR Evaluations", provision: "Rubric", quote: "No 'Supports' claims contradicted by notes", rationale: "The university grades the report on 16 quality items and does not reject products on that grade. It supports a separate measure of how far the report can be trusted.", kind: "interpretation"},
  {h: "principle:report-quality-separate-from-accessibility", s: "WebAIM, Making VPATs and ACRs More Effective in Procurement (2024)", provision: "Remarks", quote: "cannot be empty, even if the vendor states", rationale: "WebAIM scores items by the evidence behind them and asks for remarks on every row. It supports measuring report quality by what the report shows was tested.", kind: "interpretation"},
  {h: "principle:report-quality-separate-from-accessibility", s: "McNeilly and Bahram, How to Read a VPAT: Assessing Accessibility Conformance Reports (2019)", provision: "Red flags", quote: "should be significantly suspect", rationale: "The paper lists the red flags of a weak report, including unexplained Not Applicable rows and Supports on every row, and a five-part test of a credible one.", kind: "interpretation"},
  {h: "principle:report-quality-separate-from-accessibility", s: "Colorado State University, Purchasing Technology/Procurement", provision: "Procurement", quote: "A flawless ACR is not realistic, and raises questions about the vendor's understanding of accessibility.", rationale: "The university treats a report without failures as a warning sign. It supports the principle's second claim directly.", kind: "interpretation"},
  {h: "principle:report-quality-separate-from-accessibility", s: "Willis and O'Reilly, Enhancing Visibility of Vendor Accessibility Documentation (2018)", provision: "Literature review", quote: "accurate about 80 percent of the time", rationale: "The paper restates that vendor VPATs were accurate about 80 percent of the time, and finds that most vendors had no findable VPAT. It supports reading a missing report as missing evidence, not as conformance.", kind: "scholarship"},
  {h: "principle:report-quality-separate-from-accessibility", s: "UC Berkeley, Accessible Technology Procurement Review Process", provision: "Review process", quote: "completed within the past 12 to 18 months", rationale: "The university sets an age limit on the ACR and sends unverifiable reports to testing. It supports the claim that a report is valid only for the time it covers.", kind: "interpretation"},
  {h: "principle:report-quality-separate-from-accessibility", s: "Roselli, How I Evaluate an ACR (VPAT) (2026)", provision: "Evaluation checklist", quote: "not a thorough review", rationale: "Roselli checks that product and version match and treats testing on one browser and one screen reader as not thorough. It supports limiting a report to the version and platform it covers.", kind: "interpretation"},
  {h: "principle:report-quality-separate-from-accessibility", s: "Evans, Reading a VPAT (2023)", provision: "Reading a VPAT", quote: "identify the function or feature with issues", rationale: "Equal Entry checks that each platform has its own report and that Not Applicable still holds for the current version.", kind: "interpretation"},
  {h: "principle:severity-calls-need-anchors", s: "Brajnik, Yesilada and Harper, Is accessibility conformance an elusive property? (2012)", provision: "Abstract", quote: "almost never occurred", rationale: "An 80 percent agreement level among experienced evaluators almost never occurred. It supports treating one reviewer's conformance verdict as carrying known error. Read from the abstract.", kind: "scholarship"},
  {h: "principle:severity-calls-need-anchors", s: "Brajnik, Yesilada and Harper, Testability and Validity of WCAG 2.0: The Expertise Effect (2010)", provision: "Abstract", quote: "the expertise effect", rationale: "Experts missed about a third of true problems and non-experts about half. It supports anchoring calls and weighing who made them. Read from the abstract.", kind: "scholarship"},
  {h: "principle:severity-calls-need-anchors", s: "Brajnik, Yesilada and Harper, The Expertise Effect on Web Accessibility Evaluation Methods (2011)", provision: "Abstract", quote: "The Expertise Effect on Web Accessibility Evaluation Methods", rationale: "Results stabilise only with several experts. It supports a second look where one reviewer's call decides an outcome. Read from the abstract.", kind: "scholarship"},
  {h: "principle:severity-calls-need-anchors", s: "Hertzum, Molich and Jacobsen, What you get is what you see: revisiting the evaluator effect (2014)", provision: "Abstract", quote: "persisted even for the most severe problems", rationale: "Professionals rated the same problem critical and minor about a quarter of the time. It supports written severity anchors. The study is about usability, not accessibility.", kind: "scholarship"},
  {h: "principle:severity-calls-need-anchors", s: "Vigo, Brown and Conway, Benchmarking web accessibility evaluation tools (2013)", provision: "Results", quote: "measuring the harm of sole reliance on automated tests", rationale: "Automated tools checked a minority of WCAG issues. It supports treating a tool-only verdict as provisional. Read from secondary summaries.", kind: "scholarship"}
] AS row
MATCH (p:Principle {handle: row.h})
MATCH (s:IntellectualSource {name: row.s})
MERGE (p)-[r:derives_from]->(s)
ON CREATE SET r.grounding_kind = row.kind, r.provision = row.provision, r.quote = row.quote,
              r.rationale = row.rationale, r.assessed_date = date("2026-10-17");

// --- 5. derives_from the GSA ACR Supplement (existing Guideline) -----------------------
MATCH (p:Principle {handle: "principle:severity-from-task-impact"})
MATCH (g:Guideline {unique_id: "75f09ff53f6d44ecb14aba480beedfcf"})
MERGE (p)-[r:derives_from]->(g)
ON CREATE SET r.grounding_kind = "interpretation", r.provision = "Issue severity",
              r.quote = "A critical accessibility failure prevents people with disabilities from accessing or completing core functionality.",
              r.rationale = "GSA built a separate severity layer for ACR issues, defined by the effect on core functionality, because the conformance labels carry no severity. Quote verified against the stored text of the Section508.gov ACR Supplement page. Guidance, not a rule that binds the CSU.",
              r.assessed_date = date("2026-10-17");

// --- 6. contested_by (3) ------------------------------------------------------------
UNWIND [
  {h: "principle:severity-from-task-impact", s: "University of Arizona, VPAT Review Guide", provision: "Decision framework", quote: null, rationale: "Quote not captured. The guide maps the share of Supports rows to approve, conditional approval or seek alternatives, so it reads severity from the count of conformance labels. That is the reading the principle rejects. The guide also names priority criteria, which partly concedes the point."},
  {h: "principle:severity-from-task-impact", s: "University of Arkansas, About VPAT", provision: "Criteria score", quote: "Clearly lacks significant accessible functionality", rationale: "The rubric scores accessibility by the share of applicable criteria supported, a count of labels rather than an effect on tasks."},
  {h: "principle:severity-from-task-impact", s: "Tarnoff, Understanding VPATs and ACRs: Key Insights (2024)", provision: "Rating rule", quote: "For me this is a hard line at 50%.", rationale: "Tarnoff assigns Partially Supports and Does Not Support by the share of failing pages. His blocker test supports the principle, and his label rule contests it."}
] AS row
MATCH (p:Principle {handle: row.h})
MATCH (s:IntellectualSource {name: row.s})
MERGE (p)-[r:contested_by]->(s)
ON CREATE SET r.provision = row.provision, r.quote = row.quote, r.rationale = row.rationale,
              r.assessed_date = date("2026-10-17");
